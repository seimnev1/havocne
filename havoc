local function captureFog()
    FOG.captured = true
    pcall(function() FOG.lightingAddr = Lighting.Address or 0 end)
    if memory_read and FOG.lightingAddr ~= 0 then
        local e = memory_read("float", FOG.lightingAddr + OFF.FOG_END)
        local s2 = memory_read("float", FOG.lightingAddr + OFF.FOG_START)
        if type(e) == "number" and e > 0 then FOG.origEnd = e end
        if type(s2) == "number" then FOG.origStart = s2 end
    end
    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo then
        pcall(function() FOG.atmoAddr = atmo.Address or 0 end)
        if memory_read and FOG.atmoAddr ~= 0 then
            local d = memory_read("float", FOG.atmoAddr + OFF.ATMO_DENSITY)
            local g = memory_read("float", FOG.atmoAddr + OFF.ATMO_GLARE)
            local h = memory_read("float", FOG.atmoAddr + OFF.ATMO_HAZE)
            local of = memory_read("float", FOG.atmoAddr + OFF.ATMO_OFFSET)
            if type(d) == "number" then FOG.origDensity = d end
            if type(g) == "number" then FOG.origGlare = g end
            if type(h) == "number" then FOG.origHaze = h end
            if type(of) == "number" then FOG.origOffset = of end
        end
    end
end
local function applyNoFog()
    if not FOG.captured then captureFog() end
    if not memory_write then return end
    if FOG.lightingAddr ~= 0 then
        pcall(memory_write, "float", FOG.lightingAddr + OFF.FOG_END, 9e8)
        pcall(memory_write, "float", FOG.lightingAddr + OFF.FOG_START, 9e8)
    end
    if FOG.atmoAddr ~= 0 then
        pcall(memory_write, "float", FOG.atmoAddr + OFF.ATMO_DENSITY, 0)
        pcall(memory_write, "float", FOG.atmoAddr + OFF.ATMO_GLARE, 0)
        pcall(memory_write, "float", FOG.atmoAddr + OFF.ATMO_HAZE, 0)
        pcall(memory_write, "float", FOG.atmoAddr + OFF.ATMO_OFFSET, 0)
    end
end
local function restoreFog()
    if not FOG.captured or not memory_write then return end
    local function wr(a, v) if type(v) == "number" then pcall(memory_write, "float", a, v) end end
    if FOG.lightingAddr ~= 0 then
        wr(FOG.lightingAddr + OFF.FOG_END, FOG.origEnd)
        wr(FOG.lightingAddr + OFF.FOG_START, FOG.origStart)
    end
    if FOG.atmoAddr ~= 0 then
        wr(FOG.atmoAddr + OFF.ATMO_DENSITY, FOG.origDensity)
        wr(FOG.atmoAddr + OFF.ATMO_GLARE, FOG.origGlare)
        wr(FOG.atmoAddr + OFF.ATMO_HAZE, FOG.origHaze)
        wr(FOG.atmoAddr + OFF.ATMO_OFFSET, FOG.origOffset)
    end
end

