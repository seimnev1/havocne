P.aimLock = nil
P.aimVel = {}

P.rayOk = nil
P.rayLeft = 0

local function healthOf(e)
    local hum = e.hum or (e.m and e.m:FindFirstChild("Humanoid"))
    if not hum then return nil end
    local hp, mhp
    pcall(function() hp, mhp = hum.Health, hum.MaxHealth end)
    if not hp or not mhp or mhp <= 0 then return nil end
    return (hp / mhp) * 100
end

local function healthOk(e)
    if not CFG.aimHealth then return true end
    local pct = healthOf(e)
    if not pct then return true end
    return pct > 0
end

local function visible(wp, ignore)
    if not CFG.aimWall then return true end
    if P.rayOk == false then return true end
    if P.rayLeft <= 0 then return true end

    local cam = Camera or (Workspace and Workspace.CurrentCamera)
    if not cam then return true end

    local origin
    local ok = pcall(function() origin = cam.CFrame.Position end)
    if not ok or not origin then return true end

    local dir = wp - origin
    local dist = dir.Magnitude
    if dist < 1 then return true end

    P.rayLeft = P.rayLeft - 1

    local hit
    local rayOk = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local skip = { cam }
        local ch = me() and LP.Character
        if ch then skip[#skip + 1] = ch end
        if ignore then skip[#skip + 1] = ignore end
        params.FilterDescendantsInstances = skip
        hit = Workspace:Raycast(origin, dir, params)
    end)

    if not rayOk then
        P.rayOk = false
        return true
    end
    P.rayOk = true

    if not hit then return true end
    local d2 = (hit.Position - origin).Magnitude
    return d2 >= dist - 4
end

local function aimPartOf(e, cx, cy)
    local m = e.m
    if CFG.aimPart == "Torso" then return e.root end

    local head = e.head or m:FindFirstChild("Head")
    if CFG.aimPart == "Head" then return head or e.root end

    if not head then return e.root end
    if not cx then return head end

    local best, bestD
    for _, part in ipairs({ head, e.root }) do
        if part and part.Parent then
            local sc, on = WorldToScreen(part.Position)
            if on then
                local dx, dy = sc.X - cx, sc.Y - cy
                local dsq = dx * dx + dy * dy
                if not bestD or dsq < bestD then best, bestD = part, dsq end
            end
        end
    end
    return best or head or e.root
end

local function screenCentre()
    return VX * 0.5, VY * 0.5
end

local function pickTarget()
    local cx, cy = screenCentre()

    local function search(fov, maxDist, wantEnts, wantHaz)
        local best, bestD, bestPos
        local fovSq = fov * fov
        local maxSq = maxDist * maxDist

        local function consider(entry, wp)
            local sc, on = WorldToScreen(wp)
            if not on then return end
            local dx, dy = sc.X - cx, sc.Y - cy
            local dsq = dx * dx + dy * dy
            if dsq <= fovSq and (not bestD or dsq < bestD) then
                best, bestD, bestPos = entry, dsq, sc
            end
        end

        if wantEnts then
            for i = 1, #cache.ents do
                local e = cache.ents[i]
                local want = (e.isPlayer and CFG.aimPlayers) or
                             (not e.isPlayer and CFG.aimNpcs)
                if want and e.q <= maxSq and healthOk(e) then
                    local part = aimPartOf(e, cx, cy)
                    if part and part.Parent then
                        local wp = part.Position

                        if CFG.aimPredict > 0 then
                            local key = tostring(part)
                            local prev = P.aimVel[key]
                            if prev then
                                local k = CFG.aimPredict / 100
                                wp = wp + (wp - prev) * k * 6
                            end
                            P.aimVel[key] = part.Position
                        end
                        if visible(wp, e.m) then consider(e, wp) end
                    end
                end
            end
        end

        if wantHaz then
            if CFG.aimMines then
                local off = CFG.mineOff or 0
                for i = 1, #cache.mines do
                    local m = cache.mines[i]
                    if m.pos and m.q <= maxSq then
                        local p = m.pos
                        local mp = V3(p.X, p.Y - off, p.Z)
                        if visible(mp, m.part) then
                            consider({ hazard = m.part, hazOff = -off,
                                       fixed = mp }, mp)
                        end
                    end
                end
            end
            if CFG.aimSentry then
                for i = 1, #cache.sentries do
                    local sn = cache.sentries[i]
                    if sn.pos and sn.q <= maxSq then
                        local p = sn.pos
                        local so = CFG.sentryOff or 0
                        local sp = V3(p.X, p.Y + so, p.Z)
                        if visible(sp, sn.part) then
                            consider({ hazard = sn.part, hazOff = so,
                                       fixed = sp }, sp)
                        end
                    end
                end
            end
        end

        return best, bestPos
    end

    local range = CFG.aimUseEsp and CFG.entRange or CFG.aimMaxDist

    if not CFG.aimHazOnly then
        local e, pos = search(CFG.aimFov, range, true, false)
        if e then return e, pos end
    end

    if CFG.aimMines or CFG.aimSentry then
        return search(CFG.aimFov, range, false, true)
    end
    return nil
end

local function runAim()
    if not CFG.aimOn then P.aimLock = nil return end

    if CFG.aimWall ~= P.wallWas then
        P.wallWas = CFG.aimWall
        P.aimLock = nil
        P.rayOk = nil
    end

    P.rayLeft = 24

    local held = false
    pcall(function()
        if CFG.aimKey == 0x01 then held = ismouse1pressed()
        elseif CFG.aimKey == 0x02 then held = ismouse2pressed()
        else held = iskeypressed(CFG.aimKey) end
    end)

    if not held then P.aimLock = nil return end

    local target, sc = P.aimLock, nil

    if CFG.aimSticky and target then
        if target.m and not healthOk(target) then target = nil end
    end

    if CFG.aimSticky and target then
        local part = target.hazard or (target.m and aimPartOf(target))
        local alive = part and part.Parent
        if alive and CFG.aimWall then
            local checkPos = target.fixed or (part and part.Position)
            if checkPos and not visible(checkPos, target.hazard or target.m) then
                target = nil
            end
        end

        if target and alive then
            local wp = target.fixed
            if not wp then
                wp = part.Position
                if target.hazOff and target.hazOff ~= 0 then
                    wp = V3(wp.X, wp.Y + target.hazOff, wp.Z)
                end
            end
            local on
            sc, on = WorldToScreen(wp)
            if not on then target = nil end
        else
            target = nil
        end
    else
        target = nil
    end

    if not target then
        target, sc = pickTarget()
        P.aimLock = target
    end
    if not (target and sc) then return end

    local cx, cy = screenCentre()
    local dx, dy = sc.X - cx, sc.Y - cy

    local smoothPct = target.hazard and CFG.aimHazSmooth or CFG.aimSmooth
    local smooth = clamp(smoothPct, 1, 100) / 100
    local mx2 = floor(dx * smooth)
    local my2 = floor(dy * smooth)

    if mx2 == 0 and abs(dx) >= 1 then mx2 = dx > 0 and 1 or -1 end
    if my2 == 0 and abs(dy) >= 1 then my2 = dy > 0 and 1 or -1 end
    if mx2 == 0 and my2 == 0 then return end

    pcall(function() mousemoverel(mx2, my2) end)
end

local function drawFov()
    if not (CFG.aimOn and CFG.aimShowFov) then return end
    local cx, cy = screenCentre()
    local r = CFG.aimFov
    local col = P.aimLock and C.bad or C.mid
    local px, py
    for i = 0, 44 do
        local a2 = (i / 44) * math.pi * 2
        local nx, ny = cx + math.cos(a2) * r, cy + math.sin(a2) * r
        if px then ln(px, py, nx, ny, col, ESPZ, 0.5, 1) end
        px, py = nx, ny
    end
end

