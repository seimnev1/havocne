local V3_UP = Vector3.new(0, 2.8, 0)
local V3_DN = Vector3.new(0, -3.2, 0)
local function hpColor(r)
    r = clamp(r, 0, 1)
    return Color3.fromRGB(floor(255 * (1 - r)), floor(220 * r), 40)
end

local uiVisible = true
local keyWas, hudKeyWas = false, false
local recoilLast = 0

S:Connect(RunService.RenderStepped, function(dt)
    if not S.alive then return end
    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return end

    DT = clamp(dt or (1/60), 1/240, 0.1)   -- animation clock
    updateMouse()
    pumpSearch()

    if S.rainbow then
        S.accH = (S.accH + (S.rainbowSpeed or 40) * dt) % 360
        S:ApplyAccentHSV()
    end
    S:DrawWeather(dt)
    pcall(doAimbot)

    if RECOIL.enabled and RECOIL.cache and tick() - recoilLast >= 0.1 then
        recoilLast = tick()
        pcall(applygc, RECOIL.cache, RECOIL.payload)
    end

    local kd = false
    kd = S:KeyHeld(CFG.keyMenu)
    if kd and not keyWas then
        uiVisible = not uiVisible
        for _, w in ipairs(S.windows) do w.visible = uiVisible end
    end
    keyWas = kd

    local hk = S:KeyHeld(CFG.keyHud)
    if hk and not hudKeyWas then hudVisible = not hudVisible end
    hudKeyWas = hk

    local ck = S:KeyHeld(CFG.keyCombat)
    if ck and not S._ckWas then
        CFG.combatMode = not CFG.combatMode
        notify("Combat Mode", CFG.combatMode and "ON - loot hidden" or "OFF", 2,
               CFG.combatMode and "bad" or "good")
    end
    S._ckWas = ck

    for _, p in ipairs(S.panels) do p.visible = hudVisible and (p.want ~= false) end

    local used = false
    if uiVisible then
        local order = {}
        for i, w in ipairs(S.windows) do order[i] = w end
        table.sort(order, function(a, b) return a.z > b.z end)
        for _, w in ipairs(order) do if not used then used = w:handleInput() end end
    end
    if not used and hudVisible then
        for _, p in ipairs(S.panels) do if not used then used = p:handleInput() end end
    end
    do
        local peak = 0
        for _, w in ipairs(S.windows) do
            if w.visible and (w.anim or 0) > peak then peak = w.anim end
        end
        S.dimAnim = approach(S.dimAnim, (S.dimOn and peak) or 0, 12)
        if S.dimAnim > 0.01 then
            local vx, vy = viewport()
            S.dimSq.Position = Vector2.new(0, 0)
            S.dimSq.Size = Vector2.new(vx, vy)
            S.dimSq.Transparency = S.dimAmt * S.dimAnim
            S.dimSq.ZIndex = 20
            S.dimSq.Visible = true
        else S.dimSq.Visible = false end
    end
    for _, w in ipairs(S.windows) do w:layout() end
    for _, p in ipairs(S.panels) do p:layout() end
    drawNotes()
    drawCursor(S.showCursor and (uiVisible or hudVisible))

    local ch = LocalPlayer and LocalPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position
    local vp = Camera.ViewportSize

    for _, l in ipairs(chLines) do l.Visible = false end
    chDot.Visible = false; chCircle.Visible = false
    if CFG.showCrosshair then
        local x, y = vp.X / 2, vp.Y / 2
        local st = CFG.crosshairStyle
        local sz = CFG.crosshairSize
        local col = selCol(CFG.crosshairColor)
        local pulse = (st == "Dynamic") and floor((math.sin(tick() * 6) + 1) * 2) or 0
        if st == "Dot" then
            chDot.Position = Vector2.new(x, y); chDot.Color = col
            chDot.Radius = maxf(2, floor(sz / 3)); chDot.ZIndex = 50; chDot.Visible = true
        elseif st == "Circle" then
            chCircle.Position = Vector2.new(x, y); chCircle.Color = col
            chCircle.Radius = sz; chCircle.ZIndex = 50; chCircle.Visible = true
        else
            local gap = 3 + pulse
            for _, l in ipairs(chLines) do l.Color = col; l.ZIndex = 50; l.Visible = true end
            chLines[1].From = Vector2.new(x-gap-sz, y); chLines[1].To = Vector2.new(x-gap, y)
            chLines[2].From = Vector2.new(x+gap, y);    chLines[2].To = Vector2.new(x+gap+sz, y)
            chLines[3].From = Vector2.new(x, y-gap-sz); chLines[3].To = Vector2.new(x, y-gap)
            chLines[4].From = Vector2.new(x, y+gap);    chLines[4].To = Vector2.new(x, y+gap+sz)
        end
    end

    if CFG.showServerTimer then
        local t = floor(tick() - sessionStart)
        timerText.Text = string.format("SESSION %02d:%02d", floor(t/60), t%60)
        timerText.Position = Vector2.new(12, 40); timerText.ZIndex = 40; timerText.Visible = true
    else timerText.Visible = false end

    if CFG.showStatus then
        local fps = dt > 0 and floor(1/dt + 0.5) or 0
        statusText.Text = "SEIM | "..fps.." FPS | "..#entObjects.." ent | "
            ..#lootObjects.." loot | "..#hazObjects.." haz"
        statusText.Position = Vector2.new(12, 24); statusText.ZIndex = 40; statusText.Visible = true
    else statusText.Visible = false end

    local drawn = 0
    if (CFG.lootEnabled or CFG.itemEsp or CFG.showCrates) and myPos then
        for _, e in ipairs(lootObjects) do
            local part = e.part
            local pos = part and part.Parent and part.Position
            if pos and drawn < LOOT_POOL then
                local sc, on = WorldToScreen(pos)
                if on then
                    drawn = drawn + 1
                    local dx, dy, dz = pos.X-myPos.X, pos.Y-myPos.Y, pos.Z-myPos.Z
                    local d = floor(sqrt(dx*dx+dy*dy+dz*dz))
                    local lbl, dot = lootLabels[drawn], lootDots[drawn]
                    local txt
                    if e.luckRef and e.luckRef.Parent then
                        txt = e.name.." [luck:"..floor(e.luckRef.Value).."] ["..d.."m]"
                    else
                        txt = e.name.." ["..d.."m]"
                    end
                    if lbl.Text ~= txt then lbl.Text = txt end
                    lbl.Color = e.color
                    lbl.Position = Vector2.new(sc.X, sc.Y - 10)
                    lbl.ZIndex = 30; lbl.Visible = true
                    dot.Color = e.color; dot.Position = Vector2.new(sc.X, sc.Y + 6)
                    dot.ZIndex = 30; dot.Visible = true
                end
            end
        end
    end
    for i = drawn + 1, lootDrawn do
        lootLabels[i].Visible = false; lootDots[i].Visible = false
    end
    lootDrawn = drawn

    local eDrawn = 0
    if CFG.entityEnabled and myPos then
        for _, e in ipairs(entObjects) do
            local ph = e.hrp
            local base = ph and ph.Parent and ph.Position
            if base then
                local headSc, headOn = WorldToScreen(base + V3_UP)
                if headOn then
                    local footSc, footOn = WorldToScreen(base + V3_DN)
                    eDrawn = eDrawn + 1
                    if eDrawn > ENT_MAX then break end
                    local sl = entSlots[eDrawn]
                    local hum = e.hum
                    local hp = hum and hum.Health or 0
                    local mhp = hum and hum.MaxHealth or 100
                    local ratio = mhp > 0 and clamp(hp/mhp, 0, 1) or 0
                    local hCol = hpColor(ratio)
                    local dx, dy, dz = base.X-myPos.X, base.Y-myPos.Y, base.Z-myPos.Z
                    local dist = floor(sqrt(dx*dx+dy*dy+dz*dz))

                    local col = e.isPlayer and selCol(CFG.playerColor) or selCol(CFG.npcColor)
                    if CFG.espColorMode == "Rainbow" then
                        col = Color3.fromHSV((tick()*0.1*CFG.rainbowSpeed + dist*0.002) % 1, 0.9, 1)
                    elseif CFG.espColorMode == "Gradient" then
                        local b2 = clamp(dist/CFG.entityMaxDist, 0, 1)
                        col = Color3.fromRGB(floor(70+160*b2), floor(230-130*b2), 255)
                    end
                    local isWL = e.isPlayer and isWhitelisted(e.label)
                    if isWL then col = WL_COLOR end

                    local hx, hy = headSc.X, headSc.Y
                    local boxH
                    if footOn then boxH = maxf(abs(footSc.Y - hy), 10); e._boxH = boxH
                    else boxH = e._boxH or 60 end
                    local boxW = boxH * 0.5
                    local boxLeft = hx - boxW * 0.5
                    local boxCol = (CFG.espColorMode == "Normal" and isBoss(e.label))
                        and selCol(CFG.bossColor) or col
                    drawCornerBox(sl, boxLeft, hy, boxW, boxH, boxCol, CFG.showCornerBox)
                    drawSkeleton(sl, e,
                        CFG.espColorMode == "Normal" and selCol(CFG.skeletonColor) or col,
                        CFG.showSkeleton and dist <= CFG.skeletonMaxDist
                        and ((e.isPlayer and CFG.skeletonPlayers) or (not e.isPlayer and CFG.skeletonNPCs)))

                    local lblY = hy - 28
                    if CFG.showName then
                        local pre, nc
                        if isWL then pre = "[WL] "; nc = col
                        elseif e.isPlayer then pre = "[P] "; nc = col
                        elseif isBoss(e.label) then
                            pre = "[BOSS] "
                            nc = (CFG.espColorMode == "Normal") and selCol(CFG.bossColor) or col
                        else pre = "[NPC] "; nc = col end
                        local nt = pre .. e.label
                        if sl.cache.n ~= nt then sl.name.Text = nt; sl.cache.n = nt end
                        sl.name.Color = nc
                        sl.name.Position = Vector2.new(hx, lblY)
                        sl.name.ZIndex = 32; sl.name.Visible = true
                    else sl.name.Visible = false end

                    if CFG.showDist then
                        local dt2 = "[" .. dist .. "m]"
                        if sl.cache.d ~= dt2 then sl.dist.Text = dt2; sl.cache.d = dt2 end
                        sl.dist.Position = Vector2.new(hx, lblY + 15)
                        sl.dist.ZIndex = 32; sl.dist.Visible = true
                    else sl.dist.Visible = false end

                    if CFG.showHealth then
                        local bx = boxLeft - 7
                        sl.hpBg.From = Vector2.new(bx, hy); sl.hpBg.To = Vector2.new(bx, hy + boxH)
                        sl.hpBg.ZIndex = 31; sl.hpBg.Visible = true
                        local fb = hy + boxH * (1 - ratio)
                        sl.hpFg.Color = hCol
                        sl.hpFg.From = Vector2.new(bx, hy + boxH); sl.hpFg.To = Vector2.new(bx, fb)
                        sl.hpFg.ZIndex = 32; sl.hpFg.Visible = true
                        if S.neon and sl.hpGlow then
                            sl.hpGlow.From = sl.hpFg.From; sl.hpGlow.To = sl.hpFg.To
                            sl.hpGlow.Color = hCol; sl.hpGlow.Thickness = 8
                            sl.hpGlow.Transparency = 0.28
                            sl.hpGlow.ZIndex = 31; sl.hpGlow.Visible = true
                        elseif sl.hpGlow then sl.hpGlow.Visible = false end
                        local ht = floor(hp) .. " HP"
                        if sl.cache.h ~= ht then sl.hpTxt.Text = ht; sl.cache.h = ht end
                        sl.hpTxt.Color = hCol
                        sl.hpTxt.Position = Vector2.new(hx, hy + boxH + 4)
                        sl.hpTxt.ZIndex = 32; sl.hpTxt.Visible = true
                    else
                        sl.hpBg.Visible=false; sl.hpFg.Visible=false; sl.hpTxt.Visible=false
                        if sl.hpGlow then sl.hpGlow.Visible = false end
                    end

                    if CFG.showWeapon then
                        if not e._wname then
                            local tool = e.char and e.char:FindFirstChildOfClass("Tool")
                            if tool then e._wname = tool.Name end
                        end
                        local wn = e._wname
                        if wn then
                            if #wn > 24 then wn = wn:sub(1, 21) .. "..." end
                            local wt = "< " .. wn .. " >"
                            if sl.cache.w ~= wt then sl.weapon.Text = wt; sl.cache.w = wt end
                            sl.weapon.Position = Vector2.new(hx, hy + boxH + 17)
                            sl.weapon.ZIndex = 32; sl.weapon.Visible = true
                        else sl.weapon.Visible = false end
                    else sl.weapon.Visible = false end
                end
            end
        end
    end
    for i = eDrawn + 1, entDrawn do hideEnt(entSlots[i]) end
    entDrawn = eDrawn

    S:DrawArrows(entObjects, myPos, vp, CFG.entityEnabled and CFG.showArrows)
    S:PollTracers(CFG.tracersOn, entObjects, myPos)

    if CFG.showNearbyCounter then
        local pc, nc2, bc, off = 0, 0, 0, 0
        for _, e in ipairs(entObjects) do
            local part = e.hrp
            if part and part.Parent then
                if e.isPlayer then pc = pc + 1
                elseif isBoss(e.label) then bc = bc + 1
                else nc2 = nc2 + 1 end
                local _, on = WorldToScreen(part.Position + V3_UP)
                if not on then off = off + 1 end
            end
        end
        nearbyText.Text = "[ NEARBY ] P:"..pc.."  NPC:"..nc2.."  BOSS:"..bc.."  OFF:"..off
        nearbyText.Position = Vector2.new(vp.X * 0.5, 56)
        nearbyText.ZIndex = 40; nearbyText.Visible = true
    else nearbyText.Visible = false end

    local hDrawn = 0
    if myPos then
        for _, e in ipairs(hazObjects) do
            local part = e.part
            local pos = part and part.Parent and part.Position
            local fade = 1
            if not pos then
                local pk = partKey(part)
                if pk then
                    S.hazDied[pk] = S.hazDied[pk] or tick()
                    fade = 1 - clamp((tick() - S.hazDied[pk]) / HAZ_FADE, 0, 1)
                end
                pos = e.lastPos
            else
                e.lastPos = pos          -- remember it in case it gets destroyed
            end
            if pos and fade > 0.02 and hDrawn < HAZ_POOL then
                local sc, on = WorldToScreen(pos)
                if on then
                    hDrawn = hDrawn + 1
                    local dx, dy, dz = pos.X-myPos.X, pos.Y-myPos.Y, pos.Z-myPos.Z
                    local d = floor(sqrt(dx*dx+dy*dy+dz*dz))
                    local lbl, dot = hazLabels[hDrawn], hazDots[hDrawn]
                    local ring, dm = hazRings[hDrawn], hazDia[hDrawn]
                    local txt = e.label .. " [" .. d .. "m]"
                    if lbl.Text ~= txt then lbl.Text = txt end
                    lbl.Color = e.color
                    lbl.Position = Vector2.new(sc.X, sc.Y - 10)
                    lbl.ZIndex = 30; lbl.Visible = true
                    local mx2, my2 = sc.X, sc.Y + 6
                    dot.Color = e.color; dot.Position = Vector2.new(mx2, my2); dot.ZIndex = 30
                    if e.isMine then
                        if d > CFG.mineLabelDist then lbl.Visible = false end
                        local st = CFG.mineStyle
                        ring.Color = e.color; ring.Position = Vector2.new(mx2, my2); ring.ZIndex = 30
                        if st == "Static Ring" then
                            ring.Filled=false; ring.Transparency=1; ring.Radius=9
                            ring.Visible=true; dot.Radius=3; dot.Visible=true; hideDia(dm)
                        elseif st == "Filled Circle" then
                            local p2 = (math.sin(tick()*4)+1)*0.5
                            ring.Filled=true; ring.Transparency=0.35; ring.Radius=8+p2*3
                            ring.Visible=true; dot.Visible=false; hideDia(dm)
                        elseif st == "Diamond" then
                            local sz2 = 8
                            setLine(dm[1], mx2, my2-sz2, mx2+sz2, my2, e.color, true)
                            setLine(dm[2], mx2+sz2, my2, mx2, my2+sz2, e.color, true)
                            setLine(dm[3], mx2, my2+sz2, mx2-sz2, my2, e.color, true)
                            setLine(dm[4], mx2-sz2, my2, mx2, my2-sz2, e.color, true)
                            for _, l in ipairs(dm) do l.ZIndex = 30 end
                            ring.Visible=false; dot.Radius=2; dot.Visible=true
                        elseif st == "Dot Only" then
                            ring.Visible=false; dot.Radius=5; dot.Visible=true; hideDia(dm)
                        elseif st == "None" then
                            ring.Visible=false; dot.Visible=false; hideDia(dm)
                        else
                            local p2 = (math.sin(tick()*4)+1)*0.5
                            ring.Filled=false; ring.Transparency=1; ring.Radius=7+p2*5
                            ring.Visible=true; dot.Radius=3; dot.Visible=true; hideDia(dm)
                        end
                    else
                        ring.Visible=false; hideDia(dm)
                        dot.Radius=4; dot.Filled=true; dot.Visible=true
                    end
                    lbl.Transparency = fade
                    dot.Transparency = fade
                    ring.Transparency = (ring.Transparency or 1) * fade
                    for _, l in ipairs(dm) do l.Transparency = fade end
                end
            end
        end
    end
    for i = hDrawn + 1, hazDrawn do
        hazLabels[i].Visible=false; hazDots[i].Visible=false
        hazRings[i].Visible=false; hideDia(hazDia[i])
    end
    hazDrawn = hDrawn

    if CFG.invEnabled and myPos then
        local held = S:KeyHeld(CFG.keyInv)
        if not held then
            pInv.want = false; invCur = nil
        else
            local cx, cy = vp.X * 0.5, vp.Y * 0.5
            local hrSq = CFG.invHoverRadius * CFG.invHoverRadius
            local found = nil
            for _, e in ipairs(entObjects) do
                local p = e.hrp
                if p and p.Parent then
                    local sc, on = WorldToScreen(p.Position + V3_UP)
                    if on then
                        local dx, dy = sc.X - cx, sc.Y - cy
                        if dx*dx + dy*dy <= hrSq then found = e break end
                    end
                end
            end
            if found then
                invTimer = invTimer + dt
                if found ~= invCur or invTimer >= 1 then
                    invCur = found; invTimer = 0
                    invCurLines = {}
                    local label
                    if found.isPlayer then label = "[PLAYER] " .. found.label
                    elseif isBoss(found.label) then label = "[BOSS] " .. found.label
                    else label = "[NPC] " .. found.label end
                    if found.char and found.char.Parent then
                        if not found.isPlayer then
                            local ok, bpl = pcall(npcBackpack, found.char)
                            if ok and bpl and #bpl > 0 then
                                invCurLines = { { text = label, color = T.bad },
                                                { text = "[Backpack]", color = Color3.fromRGB(255,200,60) } }
                                for _, l in ipairs(bpl) do invCurLines[#invCurLines+1] = l end
                            else
                                local ok2, secs = pcall(collectInv, found.char, found.plr)
                                if ok2 and secs then invCurLines = buildInvLines(label, secs)
                                else invCurLines = { { text = label, color = T.bad },
                                                     { text = "  (no data)", color = T.textDim } } end
                            end
                        else
                            local ok2, secs = pcall(collectInv, found.char, found.plr)
                            if ok2 and secs then invCurLines = buildInvLines(label, secs)
                            else invCurLines = { { text = label, color = T.accent },
                                                 { text = "  (read error)", color = T.textDim } } end
                        end
                    end
                end
                if invCurLines ~= pInv._pushed then
                    local rows = {}
                    for i = 1, minf(#invCurLines, INV_LINES) do
                        rows[i] = { left = invCurLines[i].text, color = invCurLines[i].color }
                    end
                    if #rows == 0 then rows[1] = { left = "  (no data)", color = T.textDim } end
                    pInv:Set(rows)
                    pInv._pushed = invCurLines
                end
                pInv.want = true
            else
                invCur = nil; pInv.want = false
            end
        end
    else
        pInv.want = false
    end
end)

