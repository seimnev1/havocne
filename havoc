local function drawSkeleton(slot, e, col, vis)
    if not vis then
        for _, b in ipairs(slot.bones) do b.Visible = false end
        for _, g in ipairs(slot.boneGlow) do g.Visible = false end
        return
    end
    while #slot.bones < #SKEL_LINKS do slot.bones[#slot.bones + 1] = mkLine(col, 1) end
    local neon = S.neon and #slot.bxGlow > 0
    if neon then
        while #slot.boneGlow < #SKEL_LINKS do
            slot.boneGlow[#slot.boneGlow + 1] = mkLine(col, 4)
        end
    end
    local hot = neon and cLerp(col, Color3.fromRGB(255, 255, 255), 0.5) or col
    local rig = e.rig
    if not rig then rig = resolveRig(e.char); e.rig = rig end
    for i = 1, #SKEL_LINKS do
        local line = slot.bones[i]
        local g = neon and slot.boneGlow[i] or nil
        local pair = rig[i]
        local shown = false
        if pair then
            local a, b = pair[1], pair[2]
            local ap = a and a.Parent and a.Position
            local bp = b and b.Parent and b.Position
            if ap and bp then
                local as, aon = WorldToScreen(ap)
                local bs, bon = WorldToScreen(bp)
                if aon and bon then
                    setLine(line, as.X, as.Y, bs.X, bs.Y, hot, true)
                    shown = true
                    if g then
                        g.From = line.From; g.To = line.To
                        g.Color = col; g.Thickness = 4; g.Transparency = 0.24
                        g.ZIndex = 24; g.Visible = true
                    end
                else line.Visible = false end
            else e.rig = nil; line.Visible = false end
        else line.Visible = false end
        if g and not shown then g.Visible = false end
    end
    if not neon then
        for _, gb in ipairs(slot.boneGlow) do gb.Visible = false end
    end
end

