local function rebuildSentries(myPos)
    local out = {}
    local sf = resolve("sentry", function()
        return Workspace.Buildings.EventObjects.Sentries
    end)
    if not sf then cache.sentries = out return end

    local ok, kids = pcall(function() return sf:GetChildren() end)
    if not (ok and kids) then cache.sentries = out return end

    local rng = CFG.hazRange * CFG.hazRange
    for _, obj in ipairs(kids) do
        local part = obj:FindFirstChild("Rotator")
            or obj:FindFirstChild("Gun")
            or obj:FindFirstChild("Barrel")
            or obj:FindFirstChild("Turret")

        if not part then
            local okk, parts = pcall(function() return obj:GetChildren() end)
            if okk and parts then
                local best, bestY
                for _, c in ipairs(parts) do
                    if c:IsA("BasePart") then
                        local py = c.Position.Y
                        if not bestY or py > bestY then best, bestY = c, py end
                    end
                end
                part = best
            end
        end

        part = part or obj:FindFirstChild("Base")
            or obj:FindFirstChildWhichIsA("BasePart")
        if part and part.Parent then
            local p = part.Position
            local dx, dy, dz = p.X - myPos.X, p.Y - myPos.Y, p.Z - myPos.Z
            local q = dx * dx + dy * dy + dz * dz
            if q <= rng then
                out[#out + 1] = { part = part, q = q, name = obj.Name, pos = p }
            end
        end
    end
    table.sort(out, function(a, b) return a.q < b.q end)
    for i = #out, 21, -1 do out[i] = nil end
    cache.sentries = out
end

local function rebuildLoot(myPos)
    local out = {}
    local rng = CFG.lootRange * CFG.lootRange
    local function push(obj, tag)
        local root = obj:FindFirstChildWhichIsA("BasePart")
        if not (root and root.Parent) then return end
        local p = root.Position
        local dx, dy, dz = p.X - myPos.X, p.Y - myPos.Y, p.Z - myPos.Z
        local q = dx * dx + dy * dy + dz * dz
        if q > rng then return end
        out[#out + 1] = { part = root, name = obj.Name, q = q, tag = tag }
    end

    if CFG.lootOn then
        local itf = resolve("items", function()
            return Workspace.Buildings.Loots.Items
        end)
        if itf then
            local any = false
            for _ in pairs(CFG.picked) do any = true break end
            local ok, kids = pcall(function() return itf:GetChildren() end)
            if ok and kids then
                for _, o in ipairs(kids) do
                    if not (CFG.pickOnly and any) or CFG.picked[o.Name] then
                        push(o, CFG.picked[o.Name] and "star" or "item")
                    end
                end
            end
        end
    end
    if CFG.crates then
        local cf = resolve("crates", function()
            return Workspace.Buildings.Loots.Loots.Crates
        end)
        if cf then
            local ok, kids = pcall(function() return cf:GetChildren() end)
            if ok and kids then
                local anyPicked = false
                for _ in pairs(CFG.crateSel) do anyPicked = true break end

                local function wantCrate(name)
                    noteCrate(name)
                    if CFG.cratePick and anyPicked then
                        if CFG.crateSel[name] then return true end
                        for pick in pairs(CFG.crateSel) do
                            if crateMatch(name, pick) then return true end
                        end
                        return false
                    end
                    return crateMatch(name, CFG.crateType)
                end

                for _, o in ipairs(kids) do
                    if o:FindFirstChildWhichIsA("BasePart") then
                        if wantCrate(o.Name) then push(o, "crate") end
                    else
                        local ok2, sub = pcall(function() return o:GetChildren() end)
                        if ok2 and sub then
                            for _, s in ipairs(sub) do
                                if wantCrate(s.Name) then push(s, "crate") end
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(out, function(a, b) return a.q < b.q end)
    for i = #out, LOOT_BUDGET + 1, -1 do out[i] = nil end
    cache.loot = out
end

