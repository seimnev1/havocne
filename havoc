local function drawInventory()
    local inv = P.inv
    if not inv.target then return end

    local pad = 10
    local rowH = 14
    local slots = inv.slots or {}
    local shown = min(#inv.rows, CFG.invRows)
    local w = 232
    local slotH = #slots > 0 and (#slots * 13 + 6) or 0
    local h = 46 + slotH + shown * rowH + 8
    local x = VX - w - 24
    local y = floor(VY * 0.5 - h * 0.5)
    local Z = ESPZ + 20

    box(x, y, w, h, C.shell, Z, 0.92, true, 8)
    box(x, y, w, h, C.hair, Z + 1, 0.7, false, 8)
    box(x, y, 3, h, acc(), Z + 2, 1, true, 1)

    invSay(inv.target, x + pad, y + 8, C.text, Z + 3, 12, false)
    invSay(inv.total .. " items", x + pad, y + 24, C.dim, Z + 3, 10, false)
    if inv.cash > 0 then
        local cashText = inv.cash .. " cash"
        local co = invSay(cashText, 0, y + 24, rgb(120, 230, 140), Z + 3, 10, false)
        co.Position = V2(floor(x + w - pad - #cashText * 5.5), y + 24)
    end

    local ry = y + 42

    if #slots > 0 then
        for i = 1, #slots do
            local sl = slots[i]
            invSay(sl.slot, x + pad, ry, C.dim, Z + 3, 9, false)
            local col = TIER_TINT[sl.tier] or C.text
            local wo = invSay(sl.name, 0, ry - 1, col, Z + 3, 10, false)
            wo.Position = V2(floor(x + w - pad - widthOfText(sl.name, 10)), ry - 1)
            ry = ry + 13
        end
        ln(x + pad, ry + 1, x + w - pad, ry + 1, C.hair, Z + 3, 0.6, 1)
        ry = ry + 6
    end

    for i = 1, shown do
        local row = inv.rows[i]
        if row then
            if row.head then
                invSay(row.name, x + pad, ry, C.mid, Z + 3, 10, false)
            else
                local col = TIER_TINT[row.tier] or C.mid
                if row.money then col = rgb(120, 230, 140) end
                invSay(row.name, x + pad + 6, ry, col, Z + 3, 10, false)
                if row.amount and row.amount > 1 then
                    local amt = "x" .. floor(row.amount)
                    local ao = invSay(amt, 0, ry, C.dim, Z + 3, 10, false)
                    ao.Position = V2(floor(x + w - pad - #amt * 5.5), ry)
                end
            end
            ry = ry + rowH
        end
    end

    if #inv.rows > shown then
        invSay("+" .. (#inv.rows - shown) .. " more", x + pad, ry, C.dim, Z + 3, 9, false)
    end
end

