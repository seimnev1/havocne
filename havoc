local floor, min, max, abs, sqrt = math.floor, math.min, math.max, math.abs, math.sqrt
local huge, exp = math.huge, math.exp
local V2, V3 = Vector2.new, Vector3.new
local rgb = Color3.fromRGB

local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function lerp(a, b, t) return a + (b - a) * t end

local DT = 1 / 60
local function ap(cur, target, speed)
    local t = 1 - exp(-(speed or 12) * DT)
    local v = lerp(cur or 0, target, t)
    if abs(v - target) < 0.0015 then return target end
    return v
end
local function eo(t) return 1 - (1 - t) ^ 3 end

local function cL(a, b, t)
    if t <= 0 then return a end
    if t >= 1 then return b end
    return rgb(floor(lerp(a.R * 255, b.R * 255, t)),
               floor(lerp(a.G * 255, b.G * 255, t)),
               floor(lerp(a.B * 255, b.B * 255, t)))
end

