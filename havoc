function Widget.list(w, x, y, width, mx, my, Z, alpha, listState)
    local T, A = State.theme, State.accent
    local rowH = 20
    local h = w.height * rowH + 8

    rect(x + 8, y, width - 16, h, T.panel, Z + 1, 0.85 * alpha, true, 5)
    rect(x + 8, y, width - 16, h, T.hair, Z + 2, 0.5 * alpha, false, 5)

    local rows = w.rows or {}
    local over = max(0, #rows - w.height)
    w.scroll = clamp(w.scroll or 0, 0, over)

    region(x + 8, y, width - 16, h, function()
        listState.widget = w
        listState.y0 = my
        listState.s0 = w.scroll
        listState.over = over
        listState.rowH = rowH
        listState.moved = false
        listState.pending = nil
    end)

    for i = 1, min(w.height, #rows) do
        local entry = rows[i + w.scroll]
        if entry then
            local ry = y + 4 + (i - 1) * rowH
            local hovered = inside(mx, my, x + 11, ry, width - 22, rowH)
            local colour = entry.colour or T.mid

            if entry.selected then
                rect(x + 11, ry, width - 22, rowH, A, Z + 3, 0.14 * alpha, true, 3)
                rect(x + 12, ry + 4, 2, rowH - 8, colour, Z + 5, alpha, true, 1)
            elseif hovered then
                rect(x + 11, ry, width - 22, rowH, T.card, Z + 3, 0.9 * alpha, true, 3)
            end

            local textX = x + 20
            if w.star then
                local sx, sy = x + 24, ry + rowH * 0.5
                local sc = entry.selected and colour or T.dim
                line(sx - 4, sy + 3, sx, sy - 4, sc, Z + 5, alpha, 1)
                line(sx, sy - 4, sx + 4, sy + 3, sc, Z + 5, alpha, 1)
                line(sx - 5, sy - 1, sx + 5, sy - 1, sc, Z + 5, alpha, 1)
                if entry.selected then
                    rect(sx - 2, sy - 2, 4, 4, colour, Z + 6, alpha, true, 2)
                end
                textX = x + 36
            end

            text(entry.text, textX, ry + 3,
                 entry.selected and T.text or (hovered and T.text or colour),
                 Z + 5, 11, false, alpha)

            local eRef, iRef = entry, i + w.scroll
            region(x + 11, ry, width - 22, rowH, function()
                listState.widget = w
                listState.y0 = my
                listState.s0 = w.scroll
                listState.over = over
                listState.rowH = rowH
                listState.moved = false
                listState.pending = { entry = eRef, index = iRef }
            end)
        end
    end

    if #rows == 0 then
        text(w.empty or "empty", x + width * 0.5, y + h * 0.5 - 6,
             T.dim, Z + 5, 11, true, alpha)
    end

    if over > 0 then
        local barX = x + width - 20
        local upHot = inside(mx, my, barX - 2, y + 4, 16, 16)
        local dnHot = inside(mx, my, barX - 2, y + h - 20, 16, 16)

        rect(barX - 2, y + 4, 16, 16, T.card, Z + 4,
             (upHot and 0.95 or 0.55) * alpha, true, 3)
        rect(barX - 2, y + h - 20, 16, 16, T.card, Z + 4,
             (dnHot and 0.95 or 0.55) * alpha, true, 3)

        local uc = upHot and T.text or T.mid
        local dc = dnHot and T.text or T.mid
        line(barX + 2, y + 13, barX + 6, y + 8, uc, Z + 6, alpha, 1.4)
        line(barX + 6, y + 8, barX + 10, y + 13, uc, Z + 6, alpha, 1.4)
        line(barX + 2, y + h - 15, barX + 6, y + h - 10, dc, Z + 6, alpha, 1.4)
        line(barX + 6, y + h - 10, barX + 10, y + h - 15, dc, Z + 6, alpha, 1.4)

        local wRef = w
        region(barX - 2, y + 4, 16, 16, function()
            wRef.scroll = max(0, wRef.scroll - w.height)
        end)
        region(barX - 2, y + h - 20, 16, 16, function()
            wRef.scroll = min(over, wRef.scroll + w.height)
        end)

        local trackY = y + 24
        local trackH = h - 48
        local th = max(18, trackH * (w.height / #rows))
        local tp = trackY + (trackH - th) * (w.scroll / over)
        rect(barX + 4, trackY, 3, trackH, T.card, Z + 4, alpha, true, 2)
        rect(barX + 4, tp, 3, th, T.track, Z + 5, alpha, true, 2)

        local tyRef, thRef, trRef, ovRef = trackY, th, trackH, over
        region(barX, trackY, 12, trackH, function()
            listState.widget = wRef
            listState.bar = { y = tyRef, h = trRef, t = thRef, over = ovRef }
            listState.pending = nil
            listState.moved = true
        end)
    end

    return h + 6
end

function Widget.label(w, x, y, width, Z, alpha)
    local T = State.theme
    local str = type(w.text) == "function" and w.text() or w.text
    text(str, x + 10, y + 3, T.dim, Z + 2, 11, false, alpha)
    return 18
end

UI._binds = {}

local widgetSeq = 0
local function nextId()
    widgetSeq = widgetSeq + 1
    return widgetSeq
end

local Section = {}
Section.__index = Section

local function addWidget(section, w)
    w.id = nextId()
    w.flag = w.flag or nil

    function w:SetTitle(str)
        self.text = str
        UI._forceDraw = true
        return self
    end

    function w:Get() return self.value end
    function w:Set(v)
        if self.min then
            v = clamp(v, self.min, self.max)
            if not self.decimals then v = floor(v + 0.5) end
        end
        self.value = v
        if self.callback then pcall(self.callback, v) end
        return self
    end
    section.widgets[#section.widgets + 1] = w
    return w
end

function Section:Toggle(o)
    return addWidget(self, { kind = "toggle", flag = o.flag, text = o.text or "Toggle",
                             value = o.default or false, callback = o.callback })
end

function Section:Slider(o)
    return addWidget(self, { kind = "slider", flag = o.flag, text = o.text or "Slider",
                             value = o.default or o.min or 0,
                             min = o.min or 0, max = o.max or 100,
                             suffix = o.suffix, decimals = o.decimals,
                             callback = o.callback })
end

function Section:Dropdown(o)
    return addWidget(self, { kind = "dropdown", flag = o.flag, text = o.text or "Select",
                             options = o.options or {},
                             value = o.default or (o.options and o.options[1]),
                             callback = o.callback })
end

function Section:Button(o)
    return addWidget(self, { kind = "button", text = o.text or "Button",
                             callback = o.callback })
end

function Section:Keybind(o)
    local w = addWidget(self, { kind = "keybind", flag = o.flag, text = o.text or "Keybind",
                                value = o.default, listening = false,
                                callback = o.callback, onPress = o.onPress })
    UI._binds[#UI._binds + 1] = w
    return w
end

function Section:Search(o)
    return addWidget(self, { kind = "search", flag = o.flag, value = o.default or "",
                             placeholder = o.placeholder or "Search",
                             focused = false, selectAll = false,
                             callback = o.callback })
end

function Section:Color(o)
    return addWidget(self, { kind = "colour", flag = o.flag, text = o.text or "Colour",
                             value = o.default or State.accent,
                             callback = o.callback })
