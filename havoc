local function rect(x, y, w, h, colour, z, alpha, filled, corner)
    usedCount.rect = usedCount.rect + 1
    local o = pool.rect[usedCount.rect]
    if not o then o = makeRect(); pool.rect[usedCount.rect] = o end

    local pos, size = V2(floor(x), floor(y)), V2(floor(w), floor(h))
    if o.Position ~= pos then o.Position = pos end
    if o.Size ~= size then o.Size = size end
    if o.Color ~= colour then o.Color = colour end

    local isFilled = filled ~= false
    if o.Filled ~= isFilled then o.Filled = isFilled end
    if o.ZIndex ~= z then o.ZIndex = z end

    local a = alpha or 1
    if o.Transparency ~= a then o.Transparency = a end
    if corner then setProp(o, "Corner", corner) end

    o.Visible = true
    return o
end

local function text(str, x, y, colour, z, size, centre, alpha)
    usedCount.text = usedCount.text + 1
    local o = pool.text[usedCount.text]
    if not o then o = makeText(); pool.text[usedCount.text] = o end

    str = tostring(str)
    if o.Text ~= str then o.Text = str end

    local sz = size or 12
    if o.Size ~= sz then setProp(o, "Size", sz) end

    local isCentre = centre == true
    if o.Center ~= isCentre then setProp(o, "Center", isCentre) end

    local pos = V2(floor(x), floor(y))
    if o.Position ~= pos then o.Position = pos end
    if o.Color ~= colour then o.Color = colour end
    if o.ZIndex ~= z then o.ZIndex = z end

    local a = alpha or 1
    if o.Transparency ~= a then o.Transparency = a end

    o.Visible = true
    return o
end

local function line(x1, y1, x2, y2, colour, z, alpha, thickness)
    usedCount.line = usedCount.line + 1
    local o = pool.line[usedCount.line]
    if not o then o = makeLine(); pool.line[usedCount.line] = o end

    o.From = V2(floor(x1), floor(y1))
    o.To = V2(floor(x2), floor(y2))
    if o.Color ~= colour then o.Color = colour end
    if o.ZIndex ~= z then o.ZIndex = z end

    local a = alpha or 1
    if o.Transparency ~= a then o.Transparency = a end

    local th = thickness or 1
    if o.Thickness ~= th then o.Thickness = th end

    o.Visible = true
    return o
end

local function tri(x1, y1, x2, y2, x3, y3, colour, z, alpha)
    usedCount.tri = usedCount.tri + 1
    local o = pool.tri[usedCount.tri]
    if not o then o = makeTri(); pool.tri[usedCount.tri] = o end

    o.PointA = V2(floor(x1), floor(y1))
    o.PointB = V2(floor(x2), floor(y2))
    o.PointC = V2(floor(x3), floor(y3))
    if o.Color ~= colour then o.Color = colour end
    if o.ZIndex ~= z then o.ZIndex = z end
    local a2 = alpha or 1
    if o.Transparency ~= a2 then o.Transparency = a2 end
    o.Visible = true
    return o
end

