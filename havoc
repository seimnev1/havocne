local function widgetState()
    local out = {}
    for key, wd in pairs(S.widgets) do
        if wd.kind == "toggle" then out[key] = { k = "t", v = wd.value }
        elseif wd.kind == "slider" then out[key] = { k = "s", v = wd.value }
        elseif wd.kind == "dropdown" then out[key] = { k = "d", v = wd.options[wd.index] }
        elseif wd.kind == "keybind" then out[key] = { k = "k", v = wd.vk or -1 }
        end
    end
    local names = {}
    for n in pairs(_wl) do names[#names + 1] = n end
    table.sort(names)
    out["__whitelist"] = { k = "wl", v = names }
    local items = {}
    for n in pairs(CFG.selectedItems) do items[#items + 1] = n end
    table.sort(items)
    out["__items"] = { k = "it", v = items }
    return out
end

local function applyState(st)
    if type(st) ~= "table" then return 0 end
    local n = 0
    local wl = st["__whitelist"]
    if type(wl) == "table" and type(wl.v) == "table" then
        _wl = {}
        for _, name in ipairs(wl.v) do
            if type(name) == "string" then _wl[name:lower()] = true end
        end
        n = n + 1
    end
    local it = st["__items"]
    if type(it) == "table" and type(it.v) == "table" then
        CFG.selectedItems = {}
        for _, name in ipairs(it.v) do
            if type(name) == "string" then CFG.selectedItems[name] = true end
        end
        n = n + 1
    end
    for key, rec in pairs(st) do
        local wd = S.widgets[key]
        if wd and type(rec) == "table" then
            if wd.kind == "toggle" and type(rec.v) == "boolean" then
                wd.value = rec.v
                if wd.cb then pcall(wd.cb, wd.value) end
                n = n + 1
            elseif wd.kind == "slider" and type(rec.v) == "number" then
                wd.value = clamp(rec.v, wd.mn, wd.mx)
                wd.pAnim = nil
                if wd.cb then pcall(wd.cb, wd.value) end
                n = n + 1
            elseif wd.kind == "dropdown" then
                for i, o in ipairs(wd.options) do
                    if o == rec.v then wd.index = i break end
                end
                if wd.cb then pcall(wd.cb, wd.options[wd.index]) end
                n = n + 1
            elseif wd.kind == "keybind" and type(rec.v) == "number" then
                wd.vk = (rec.v >= 0) and rec.v or nil
                if wd.cb then pcall(wd.cb, wd.vk) end
                n = n + 1
            end
        end
    end
    return n
end

local function cfgFile(slot) return CFG_PREFIX .. slot .. ".json" end

local function cfgExists(slot)
    local ok, r = pcall(function() return isfile and isfile(cfgFile(slot)) end)
    return ok and r and true or false
end

local function cfgSave(slot)
    local ok, err = pcall(function()
        writefile(cfgFile(slot), HttpService:JSONEncode({ state = widgetState() }))
    end)
    if ok then notify("Config", "saved to " .. slot, 3, "good")
    else notify("Config", "save failed: " .. tostring(err), 4, "bad") end
end

local function cfgLoad(slot, quiet)
    if not cfgExists(slot) then
        if not quiet then notify("Config", slot .. " is empty", 3, "bad") end
        return false
    end
    local ok, n = pcall(function()
        local raw = readfile(cfgFile(slot))
        local data = HttpService:JSONDecode(raw)
        return applyState(data and data.state)
    end)
    if ok then
        if not quiet then notify("Config", "loaded " .. slot .. " (" .. tostring(n) .. " values)", 3, "good") end
        return true
    end
    if not quiet then notify("Config", "load failed", 4, "bad") end
    return false
end

local function cfgDelete(slot)
    if not cfgExists(slot) then notify("Config", slot .. " is empty", 3, "bad") return end
    local ok = pcall(function() if delfile then delfile(cfgFile(slot)) end end)
    if ok then notify("Config", "deleted " .. slot, 3, "good")
    else notify("Config", "delete failed", 4, "bad") end
end

