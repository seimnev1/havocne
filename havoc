function Section:File(o)
    local set
    if o.filter then
        set = {}
        for _, ext in ipairs(o.filter) do set[tostring(ext):lower()] = true end
    end
    return addWidget(self, { kind = "file", text = o.text or "File",
                             value = o.default or "", root = o.root or "",
                             cwd = o.root or "", scroll = 0,
                             filter = set, showAll = o.showAll,
                             callback = o.callback })
