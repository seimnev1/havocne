function P.applyLook()
    local function try(fn, a)
        pcall(fn, a)
    end

    try(function(v) UI:SetTheme(v) end, CFG.uiTheme)
    try(function(v) UI:SetAccent(v) end, CFG.uiAccent)
    try(function(v) UI:SetFont(v) end, CFG.uiFont)
    try(setInvFont, CFG.uiFont)
    try(setEspFont, CFG.espFont)
    try(function(v) UI:SetHudVisible(v and true or false) end, CFG.showHud)
    try(function(v) UI:SetWatermarkVisible(v and true or false) end, CFG.showMark)

    try(function(v) UI:SetGlass(v and true or false) end, CFG.uiGlass)
    if not CFG.uiGlass then
        try(function(v) UI:SetOpacity((v or 97) / 100) end, CFG.uiOpacity)
    end
    try(function()
        CFG.uiOpacity = floor(UI:GetOpacity() * 100 + 0.5)
    end)

    try(applyBackground, CFG.bgName)
    try(function(v) win:SetBackgroundAlpha((v or 100) / 100) end, CFG.bgAlpha)
    try(function(v) win:SetBackgroundScrim((v or 0) / 100) end, CFG.bgScrim)

    P.skelBudget = CFG.skelBudget or 4
    if CFG.menuKey then win.key = CFG.menuKey end
    if bossHud then try(function(v) bossHud:Toggle(v and true or false) end, CFG.bossTrack) end

    if opacitySlider then
        opacitySlider.value = CFG.uiOpacity or 97
    end
end

