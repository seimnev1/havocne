local function bossDist(name)
    if not P.myPos then return nil end
    for i = 1, #P.cand do
        local c = P.cand[i]
        local ln = tostring(c.name or ""):lower()
        if ln:find(name:lower(), 1, true) and c.root and c.root.Parent then
            local pos = c.root.Position
            local dx = pos.X - P.myPos.X
            local dy = pos.Y - P.myPos.Y
            local dz = pos.Z - P.myPos.Z
            return floor(sqrt(dx * dx + dy * dy + dz * dz))
        end
    end
    return nil
end

