            end
            if mag then lines[#lines+1] = { name = "Mags: "..floor(mag.Value or 0) } end
            if dur and mdur and (mdur.Value or 0) > 0 then
                lines[#lines+1] = { name = "Condition: "..floor((dur.Value/mdur.Value)*100).."%" }
            end
