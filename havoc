P.gc = {}

local function groupWanted(g)
    for _, key in ipairs(g.needs) do
        if CFG[key] then return true end
    end
    return false
end

local function applyGc(force)
    for i = 1, #GC_GROUPS do
        local g = GC_GROUPS[i]
        local slot = P.gc[g.name]
        if not slot then slot = { cache = nil, sig = "" }; P.gc[g.name] = slot end

        if groupWanted(g) then
            local sig = ""
            for _, key in ipairs(g.needs) do
                sig = sig .. (CFG[key] and "1" or "0")
            end

            if force or not slot.cache or sig ~= slot.sig then
                slot.sig = sig
                pcall(function() slot.cache = getgc(g.keys) end)
            end

            if slot.cache then
                local vals = g.build()
                pcall(function() applygc(slot.cache, vals) end)
            end
        else
            slot.cache, slot.sig = nil, ""
        end
    end
end

local function gcStatus()
    local parts = {}
    for i = 1, #GC_GROUPS do
        local g = GC_GROUPS[i]
        local slot = P.gc[g.name]
        if slot and slot.cache then
            parts[#parts + 1] = g.name .. " " .. #slot.cache
        end
    end
    if #parts == 0 then return "no scans active" end
    return table.concat(parts, "   ")
end

local function espFrame()

    used.s, used.t, used.l = 0, 0, 0
    viewport()
    local hrp = myRoot()
    local myPos = hrp and hrp.Position
    P.myPos = myPos

    local now = tick()
    if now - P.itemAt >= 3 then
        P.itemAt = now
        pcall(refreshItems)
        if P.onItems then pcall(P.onItems) end
    end

    if myPos and (CFG.espOn or CFG.aimOn) then

        if CFG.skeleton ~= P.skelWas then
            P.skelWas = CFG.skeleton
            P.boneCache = {}
            P.boneCount = 0
            cache.at.ent = 0
        end
        if P.candAt == nil then P.candAt = 0 end
        if now - (P.candAt or 0) >= (CFG.scanEvery or 4) then
            P.candAt = now
            pcall(discoverEnts)
        end
        if now - cache.at.ent >= 0.25 then
            cache.at.ent = now
            pcall(rebuildEnts, myPos)
        end
        if now - cache.at.loot >= 1.5 then
            cache.at.loot = now
            if CFG.lootOn or CFG.crates then pcall(rebuildLoot, myPos)
            else cache.loot = {} end
        end
        if now - (cache.at.pat or 0) >= 2 then
            cache.at.pat = now
            if CFG.hostages or CFG.traders or CFG.bounties then
                pcall(rebuildPat, myPos)
            else
                cache.pat = {}
            end
        end
        if now - (cache.at.sentry or 0) >= 3 then
            cache.at.sentry = now
            if CFG.sentries or CFG.aimSentry then
                pcall(rebuildSentries, myPos)
            else
                cache.sentries = {}
            end
        end
        if now - cache.at.mine >= 6 then
            cache.at.mine = now
            if CFG.mines or CFG.aimMines then pcall(rebuildMines, myPos)
            else cache.mines = {} end
        end

        if CFG.espOn and CFG.charOn then pcall(drawEnts, myPos) end
        pcall(runAim)
        pcall(drawFov)
        if CFG.espOn and CFG.worldEsp then
            if #cache.loot > 0 then pcall(drawLoot) end
            if CFG.mines and #cache.mines > 0 then pcall(drawMines) end
            if CFG.sentries and #cache.sentries > 0 then pcall(drawSentries) end
            if #cache.pat > 0 then pcall(drawPat) end
        end
    end

    if now - (P.fxAt or 0) >= 0.5 then
        P.fxAt = now
        if CFG.noGrass or CFG.noFog or CFG.noEffects or P.fxDirty then
            P.fxDirty = CFG.noGrass or CFG.noFog or CFG.noEffects
            pcall(applyFx)
        end
    end
    if CFG.invOn and myPos then
        local held = true
        if CFG.invKey and CFG.invKey ~= 0 then
            held = keyDown(CFG.invKey)
        end
        if held then
            if now - P.inv.at >= 0.4 then
                P.inv.at = now
                local pick = invPick()
                if pick and pick.plr then
                    P.inv.target = pick.name
                    P.inv.rows, P.inv.total, P.inv.cash, P.inv.slots =
                        readInventory(pick.plr)
                    local extra = readSlots(pick.plr, pick.m)
                    for _, sl in ipairs(extra) do
                        P.inv.slots[#P.inv.slots + 1] = sl
                    end
                    P.inv.plr, P.inv.char = pick.plr, pick.m
                else
                    P.inv.target = nil
                end
            end
            if CFG.espOn then pcall(drawInventory) end
        else
            P.inv.target = nil
        end
    end
    invSweep()

    if P.reapply then
        P.reapply = false
        P.fxAt = 0
        P.fxDirty = true
        pcall(applyGc, true)
        if P.applyLook then pcall(P.applyLook) end
    end

    if now - (P.staffAt or 0) >= 2 then
        P.staffAt = now
        if P.scanStaff then pcall(P.scanStaff) end
    end
    if now - (P.gcAt or 0) >= 2 then
        P.gcAt = now
        pcall(applyGc, false)
    end

    sweep()
end

