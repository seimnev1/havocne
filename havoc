local function rebuildLoot()
    local ch = LocalPlayer and LocalPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then lootObjects = {} return end
    local myPos = hrp.Position
    local maxDSq = CFG.maxDist * CFG.maxDist
    local lf = getLootsFolder()
    if not lf then lootObjects = {} return end
    local itemsF = lf:FindFirstChild("Items")
    local loots2 = lf:FindFirstChild("Loots")
    local cratesF = loots2 and loots2:FindFirstChild("Crates")
    local out = {}

    if (CFG.lootEnabled or CFG.itemEsp) and not CFG.combatMode and itemsF then
        local ok, kids = pcall(function() return itemsF:GetChildren() end)
        if ok and kids then
            for _, obj in ipairs(kids) do
                if tierVisible(obj.Name)
                   or (CFG.itemEsp and CFG.selectedItems[obj.Name]) then
                    local root = obj:FindFirstChildWhichIsA("BasePart")
                    if root and root.Parent then
                        local rp = root.Position
                        local dx, dy, dz = rp.X-myPos.X, rp.Y-myPos.Y, rp.Z-myPos.Z
                        if dx*dx+dy*dy+dz*dz <= maxDSq then
                            out[#out+1] = { part=root, name=obj.Name, color=lootCol(itemColor(obj.Name)) }
                        end
                    end
                end
            end
        end
    end

    if CFG.showCrates and not CFG.combatMode and cratesF then
        local ok, kids = pcall(function() return cratesF:GetChildren() end)
        if ok and kids then
            local want = CFG.crateType
            for _, obj in ipairs(kids) do
                if want == "All Crates" or obj.Name == want then
                    local root = obj:FindFirstChildWhichIsA("BasePart")
                    if root and root.Parent then
                        local rp = root.Position
                        local dx, dy, dz = rp.X-myPos.X, rp.Y-myPos.Y, rp.Z-myPos.Z
                        if dx*dx+dy*dy+dz*dz <= maxDSq then
                            local data = obj:FindFirstChild("data")
                            local luck = data and data:FindFirstChild("luck")
                            out[#out+1] = { part=root, name=obj.Name,
                                color=selCol(CFG.crateColor, Color3.fromRGB(255,180,80)),
                                luckRef=luck }
                        end
                    end
                end
            end
        end
    end

    for _, e in ipairs(out) do
        local p = e.part
        local pos = p and p.Parent and p.Position
        if pos then
            local dx, dy, dz = pos.X-myPos.X, pos.Y-myPos.Y, pos.Z-myPos.Z
            e._dsq = dx*dx+dy*dy+dz*dz
        else e._dsq = 1e18 end
    end
    table.sort(out, function(a, b)
        if a._dsq == b._dsq then return a.name < b.name end
        return a._dsq < b._dsq
    end)
    lootObjects = out
end

