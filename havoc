local function makeRig(m, set, found)
    local parts, index, links = {}, {}, {}
    for _, pair in ipairs(set) do
        local p1 = found[pair[1]]
        local p2 = found[pair[2]]
        if p1 and p2 then
            if not index[p1] then
                parts[#parts + 1] = p1; index[p1] = #parts
            end
            if not index[p2] then
                parts[#parts + 1] = p2; index[p2] = #parts
            end
            links[#links + 1] = { index[p1], index[p2] }
        end
    end
    if #links == 0 then return nil end
    return { parts = parts, links = links }
end

function buildBones(m)
    local hit = P.boneCache[m]
    if hit ~= nil then
        if hit == false then return nil end
        return hit
    end

    local r15 = m:FindFirstChild("UpperTorso") ~= nil
    local set = r15 and SKEL15 or SKEL6
    local low = r15 and SKEL15_LOW or SKEL6

    local found = {}
    local function look(name)
        if found[name] == nil then
            found[name] = m:FindFirstChild(name) or false
        end
        return found[name] or nil
    end
    for _, pair in ipairs(set) do look(pair[1]); look(pair[2]) end
    for name, v in pairs(found) do if v == false then found[name] = nil end end

    local full = makeRig(m, set, found)
    local result = false
    if full then
        result = { full = full, low = makeRig(m, low, found) or full }
    end

    if P.boneCount > 160 then
        P.boneCache = {}
        P.boneCount = 0
    end
    P.boneCache[m] = result
    P.boneCount = P.boneCount + 1
    return result or nil
end

local CORNERS = {
    V3(-1, -1, -1), V3(-1, -1, 1), V3(-1, 1, -1), V3(-1, 1, 1),
    V3(1, -1, -1),  V3(1, -1, 1),  V3(1, 1, -1),  V3(1, 1, 1),
}

local function projectBoxFast(cf, halfY)
    local pos = cf.Position
    local top, onTop = WorldToScreen(pos + V3(0, halfY, 0))
    local bot, onBot = WorldToScreen(pos - V3(0, halfY, 0))
    if not (onTop and onBot) then return nil end

    local y1 = min(top.Y, bot.Y)
    local y2 = max(top.Y, bot.Y)
    local h = y2 - y1
    if h < 2 then return nil end

    local w = h * 0.62
    local cx = (top.X + bot.X) * 0.5
    return cx - w * 0.5, y1, cx + w * 0.5, y2
end

local function projectBox(cf, halfX, halfY, halfZ)
    local minX, minY, maxX, maxY = huge, huge, -huge, -huge
    local any = false
    for i = 1, 8 do
        local c = CORNERS[i]
        local wp = cf * V3(c.X * halfX, c.Y * halfY, c.Z * halfZ)
        local sc, on = WorldToScreen(wp)
        if on then
            any = true
            if sc.X < minX then minX = sc.X end
            if sc.Y < minY then minY = sc.Y end
            if sc.X > maxX then maxX = sc.X end
            if sc.Y > maxY then maxY = sc.Y end
        end
    end
    if not any then return nil end
    return minX, minY, maxX, maxY
end

local function drawCornerBox(x, y, w, h, col, z, a)
    local cw = clamp(w * 0.28, 3, 14)
    local ch = clamp(h * 0.16, 3, 16)
    local t = 1
    ln(x, y, x + cw, y, col, z, a, t)
    ln(x, y, x, y + ch, col, z, a, t)
    ln(x + w, y, x + w - cw, y, col, z, a, t)
    ln(x + w, y, x + w, y + ch, col, z, a, t)
    ln(x, y + h, x + cw, y + h, col, z, a, t)
    ln(x, y + h, x, y + h - ch, col, z, a, t)
    ln(x + w, y + h, x + w - cw, y + h, col, z, a, t)
    ln(x + w, y + h, x + w, y + h - ch, col, z, a, t)
end

local function readCFrame(part) return part.CFrame end
local function readHealth(hum) return hum.Health, hum.MaxHealth end

local function drawEnts(myPos)
    local a = acc()
    local ts = CFG.entText
    local skelDrawn = 0
    for _, e in ipairs(cache.ents) do
        local root = e.root
        if root and root.Parent then
            local okc, cf = pcall(readCFrame, root)
            if not okc then cf = nil end
        if cf then
            local x1, y1, x2, y2
            if CFG.boxAccurate then
                x1, y1, x2, y2 = projectBox(cf, 2.0, 3.0, 1.2)
            else
                x1, y1, x2, y2 = projectBoxFast(cf, 3.0)
            end
            if x1 then
                local w, h = x2 - x1, y2 - y1
                local d = floor(sqrt(e.q))
                local hum = e.hum
                local hp, mhp = 100, 100
                if hum then
                    local okh, h1, h2 = pcall(readHealth, hum)
                    if okh and h1 and h2 then hp, mhp = h1, h2 end
                end
                if mhp <= 0 then mhp = 100 end
                local frac = clamp(hp / mhp, 0, 1)

                local col = CFG.nColor
                if e.isPlayer then col = CFG.pColor
                elseif e.isBoss then col = CFG.bColor end
                if e.staff and CFG.staffTag then col = CFG.sColor end

                if CFG.boxes and CFG.boxStyle ~= "None" then
                    if CFG.boxStyle == "Full" then
                        if CFG.boxOutline then
                            box(x1 - 1, y1 - 1, w + 2, h + 2, C.black, ESPZ, 0.6, false)
                        end
                        box(x1, y1, w, h, col, ESPZ + 1, 1, false)
                    else
                        if CFG.boxOutline then
                            drawCornerBox(x1, y1, w, h, C.black, ESPZ, 0.55)
                        end
                        drawCornerBox(x1, y1, w, h, col, ESPZ + 1, 1)
                    end
                end

                if CFG.health then
                    local bx = x1 - 6
                    local bh = h
                    if CFG.boxOutline then
                        box(bx - 1, y1 - 1, 4, bh + 2, C.black, ESPZ, 0.7)
                    end
                    local fh = bh * frac
                    local hc = cL(C.bad, C.good, frac)
                    box(bx, y1 + (bh - fh), 2, fh, hc, ESPZ + 2, 1)
                end

                local ty = y1 - ts - 3
                if CFG.names then
                    say(e.name, x1 + w * 0.5, ty, C.text, ESPZ + 3, ts, true)
                    ty = ty - ts - 1
                end
                if e.staff and CFG.staffTag then
                    say("[" .. e.staff .. "]", x1 + w * 0.5, ty, CFG.sColor,
                        ESPZ + 3, ts - 1, true)
                    ty = ty - ts
                end
                if CFG.tagType then
                    say(e.isPlayer and "(Player)"
                        or (e.isBoss and "(BOSS)" or "(NPC)"),
                        x1 + w * 0.5, ty, col, ESPZ + 3, ts - 2, true)
                    ty = ty - ts + 1
                end

                local by = y2 + 2
                if CFG.distance then
                    say(d .. "m", x1 + w * 0.5, by, C.mid, ESPZ + 3, ts - 1, true)
                    by = by + ts
                end
                if CFG.weapon then
                    if e.tool then
                        say(e.tool.Name, x1 + w * 0.5, by, C.dim, ESPZ + 3, ts - 1, true)
                    end
                end

                if CFG.skeleton and e.bones and skelDrawn < P.skelBudget
                   and h >= CFG.skelMinPx
                   and e.q <= CFG.skelRange * CFG.skelRange then
                    skelDrawn = skelDrawn + 1
                    local bs = e.bones
                    local rig = bs.low
                    if CFG.skelDetail and d < CFG.skelRange * 0.45 then
                        rig = bs.full
                    end
                    local sx, sy, sok = P.skx, P.sky, P.sok
                    local pts = rig.parts

                    for i = 1, #pts do
                        local part = pts[i]
                        if part.Parent then
                            local sc2, on2 = WorldToScreen(part.Position)
                            if on2 then
                                sx[i], sy[i], sok[i] = sc2.X, sc2.Y, true
                            else
                                sok[i] = false
                            end
                        else
                            sok[i] = false
                        end
                    end

                    local lk = rig.links
                    for i = 1, #lk do
                        local a2, b2 = lk[i][1], lk[i][2]
                        if sok[a2] and sok[b2] then
                            ln(sx[a2], sy[a2], sx[b2], sy[b2], col, ESPZ + 2, 1, 1)
                        end
                    end
                end

                if CFG.headDot then
                    local head = e.head
                    if head and head.Parent then
                        local sc, on = WorldToScreen(head.Position)
                        if on then
                            box(sc.X - 2, sc.Y - 2, 4, 4, col, ESPZ + 4, 1, true, 2)
                        end
                    end
                end

                if CFG.tracers then
                    local ox, oy = VX * 0.5, VY
                    if CFG.tracerFrom == "Centre" then oy = VY * 0.5
                    elseif CFG.tracerFrom == "Top" then oy = 0 end
                    ln(ox, oy, x1 + w * 0.5, y2, col, ESPZ, 0.5, 1)
                end
            end
        end
        end
    end
end

