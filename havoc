local AIM = { enabled=false, fov=120, smooth=0.3, bone="Head", showFOV=false,
              key=0x02, targetMode="all", predTime=0.07, maxDist=300 }

local fovCircle = mkCircle(Color3.fromRGB(255,255,255), 120, false)
fovCircle.Transparency = 0.5

local entObjects = {}
local _prevPos, _prevTime, _smoothVel = {}, {}, {}
local VEL_ALPHA = 0.4

local function getBoneVel(bone)
    local now = tick()
    local cur = bone.Position
    local prev, pt = _prevPos[bone], _prevTime[bone]
    _prevPos[bone] = cur; _prevTime[bone] = now
    if not prev or not pt then _smoothVel[bone] = Vector3.new(0,0,0); return _smoothVel[bone] end
    local dt = now - pt
    if dt <= 0 or dt > 0.3 then _smoothVel[bone] = Vector3.new(0,0,0); return _smoothVel[bone] end
    local raw = (cur - prev) / dt
    local ps = _smoothVel[bone] or Vector3.new(0,0,0)
    _smoothVel[bone] = ps + (raw - ps) * VEL_ALPHA
    return _smoothVel[bone]
end

local function getNearestTarget()
    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return nil end
    local vp = Camera.ViewportSize
    local cx, cy = vp.X * 0.5, vp.Y * 0.5
    local fovSq = AIM.fov * AIM.fov
    local maxSq = AIM.maxDist * AIM.maxDist
    local best, bestD = nil, huge
    for _, e in ipairs(entObjects) do
        local cm = e.char
        if cm and cm.Parent then
            local skip = false
            if AIM.targetMode == "npc" and e.isPlayer then skip = true end
            if AIM.targetMode == "players" and not e.isPlayer then skip = true end
            if e.isPlayer and isWhitelisted(e.label) then skip = true end
            if e._dsq and e._dsq > maxSq then skip = true end
            if not skip then
                local bone = e._aimBone
                if not bone or e._aimBoneName ~= AIM.bone or not bone.Parent then
                    bone = cm:FindFirstChild(AIM.bone) or cm:FindFirstChild("HumanoidRootPart")
                    e._aimBone = bone; e._aimBoneName = AIM.bone
                end
                local hum = e.hum
                if bone and (not hum or hum.Health > 0) then
                    local bp = bone.Parent and bone.Position
                    if bp then
                        local sc, on = WorldToScreen(bp)
                        if on then
                            local dx, dy = sc.X - cx, sc.Y - cy
                            local dsq = dx * dx + dy * dy
                            if dsq < fovSq and dsq < bestD then
                                bestD = dsq; best = bone
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function doAimbot()
    Camera = Workspace.CurrentCamera or Camera
    if not Camera then fovCircle.Visible = false return end
    if AIM.showFOV and AIM.enabled then
        local vp = Camera.ViewportSize
        fovCircle.Position = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
        fovCircle.Radius = AIM.fov
        fovCircle.ZIndex = 50
        fovCircle.Visible = true
    else fovCircle.Visible = false end
    if not AIM.enabled then return end

    if not S:KeyHeld(AIM.key) then return end

    local target = getNearestTarget()
    if not target then return end
    local vel = getBoneVel(target)
    local pred = target.Position + vel * AIM.predTime
    local sc, on = WorldToScreen(pred)
    if not on then return end
    local vp = Camera.ViewportSize
    local dx, dy = sc.X - vp.X * 0.5, sc.Y - vp.Y * 0.5
    if abs(dx) < 1 and abs(dy) < 1 then return end
    local mx2 = floor(dx * AIM.smooth)
    local my2 = floor(dy * AIM.smooth)
    if mx2 == 0 and abs(dx) >= 1 then mx2 = dx > 0 and 1 or -1 end
    if my2 == 0 and abs(dy) >= 1 then my2 = dy > 0 and 1 or -1 end
    mousemoverel(mx2, my2)
end

S.uiText = false
S.TR_LIFE = 1.4
S.TR_LEN = 400
S.TR_THICK = 1
S.trMode = "Shot Ray"
S.trStyle = "Neon"
S.trLive = {}     -- key -> { sx,sy,sz, ex,ey,ez, t0, part }
S.trSeen = {}

S.trLines = {}
for i = 1, 160 do S.trLines[i] = mkLine(Color3.fromRGB(255, 230, 120), 1) end
S._nLn = 0

function S:trLn(x1, y1, x2, y2, col, alpha, thick)
    if self._nLn >= #self.trLines then return end
    self._nLn = self._nLn + 1
    local l = self.trLines[self._nLn]
    l.From = Vector2.new(x1, y1); l.To = Vector2.new(x2, y2)
    l.Color = col; l.Thickness = thick; l.Transparency = alpha
    l.ZIndex = 28; l.Visible = true
end

function S:trDraw(x1, y1, x2, y2, col, alpha, style, th)
    if style == "Line" then
        self:trLn(x1, y1, x2, y2, col, alpha, th)

    elseif style == "Neon" then
        local hot  = cLerp(col, Color3.fromRGB(255, 255, 255), 0.55)
        self:trLn(x1, y1, x2, y2, col, alpha * 0.09, th + 9)
        self:trLn(x1, y1, x2, y2, col, alpha * 0.16, th + 6)
        self:trLn(x1, y1, x2, y2, col, alpha * 0.30, th + 4)
        self:trLn(x1, y1, x2, y2, col, alpha * 0.55, th + 2)
        self:trLn(x1, y1, x2, y2, hot, alpha, th)
        self:trLn(x1, y1, x2, y2, Color3.fromRGB(255, 255, 255), alpha * 0.85,
                  maxf(1, th - 0.5))

    elseif style == "Beam" then
        self:trLn(x1, y1, x2, y2, col, alpha * 0.30, th + 3)
        self:trLn(x1, y1, x2, y2, col, alpha * 0.55, th + 1)
        self:trLn(x1, y1, x2, y2, Color3.fromRGB(255, 255, 255), alpha, th)

    elseif style == "Gradient" then
        local segs = 6
        local dx, dy = (x2 - x1) / segs, (y2 - y1) / segs
        for i = 0, segs - 1 do
            local a = alpha * (1 - i / segs)
            if a > 0.02 then
                self:trLn(x1 + dx * i, y1 + dy * i,
                          x1 + dx * (i + 1), y1 + dy * (i + 1), col, a, th + 1)
            end
        end

    end
end

function S:ShotDir(px, py, pz, ents, myPos)
    if myPos then
        local dx, dy, dz = px - myPos.X, py - myPos.Y, pz - myPos.Z
        if dx*dx + dy*dy + dz*dz < 64 then
            local _, _, _, lx, ly, lz = self:CamBasis()
            if lx then return lx, ly, lz end
        end
    end
    if ents then
        local best, bd = nil, 100
        for _, e in ipairs(ents) do
            local h = e.hrp
            local hp = h and h.Parent and h.Position
            if hp then
                local dx, dy, dz = px - hp.X, py - hp.Y, pz - hp.Z
                local d = dx*dx + dy*dy + dz*dz
                if d < bd then best, bd = h, d end
            end
        end
        if best then
            local lv
            pcall(function() lv = best.CFrame.LookVector end)
            if lv then return lv.X, lv.Y, lv.Z end
        end
    end
    return nil
end

function S:PollTracers(enabled, ents, myPos)
    self._nLn = 0
    if enabled then
        local ray = (self.trMode ~= "Casing Path")
        local ig = Workspace:FindFirstChild("Ignored")
        if ig then
            local ok, kids = pcall(function() return ig:GetChildren() end)
            if ok and kids then
                for _, d in ipairs(kids) do
                    if d.ClassName == "Part" then
                        local sz = d.Size
                        if sz and sz.X < 1 and sz.Y < 0.5 and sz.Z < 0.5 then
                            local a; pcall(function() a = d.Address end)
                            local k = a and tostring(a)
                            if k and not self.trSeen[k] then
                                self.trSeen[k] = tick()
                                local p = d.Position
                                if p then
                                    local tr = { t0 = tick(),
                                        sx = p.X, sy = p.Y, sz = p.Z,
                                        ex = p.X, ey = p.Y, ez = p.Z }
                                    if ray then
                                        local lx, ly, lz = self:ShotDir(p.X, p.Y, p.Z, ents, myPos)
                                        if lx then
                                            local L = self.TR_LEN
                                            tr.ex = p.X + lx * L
                                            tr.ey = p.Y + ly * L
                                            tr.ez = p.Z + lz * L
                                            self.trLive[k] = tr
                                        end
                                    else
                                        tr.part = d
                                        self.trLive[k] = tr
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        local now = tick()
        local col = (self.trColor == "Accent") and T.accent
            or (COLOR_PALETTE[self.trColor or "Gold"] or COLOR_PALETTE.Gold)
        local style, th = self.trStyle, self.TR_THICK
        for k, tr in pairs(self.trLive) do
            local age = now - tr.t0
            if age > self.TR_LIFE then
                self.trLive[k] = nil
            else
                if tr.part then
                    local p = tr.part.Parent and tr.part.Position
                    if p then tr.ex, tr.ey, tr.ez = p.X, p.Y, p.Z end
                end
                local s1, on1 = WorldToScreen(Vector3.new(tr.sx, tr.sy, tr.sz))
                local s2, on2 = WorldToScreen(Vector3.new(tr.ex, tr.ey, tr.ez))
                if on1 and on2 then
                    self:trDraw(s1.X, s1.Y, s2.X, s2.Y, col,
                                1 - (age / self.TR_LIFE), style, th)
                end
            end
        end
        for k, t in pairs(self.trSeen) do
            if now - t > 8 then self.trSeen[k] = nil end
        end
    else
        if next(self.trLive) then self.trLive = {}; self.trSeen = {} end
    end
    for i = self._nLn + 1, #self.trLines do self.trLines[i].Visible = false end
end

