--- Pick whoever is nearest the crosshair within range.
local function invPick()
    local cx, cy = VX * 0.5, VY * 0.5
    local best, bestD
    local rng = CFG.invRange * CFG.invRange

    for i = 1, #cache.ents do
        local e = cache.ents[i]
        if e.isPlayer and e.plr and e.q <= rng then
            local part = e.head or e.root
            if part and part.Parent then
                local sc, on = WorldToScreen(part.Position)
                if on then
                    local dx, dy = sc.X - cx, sc.Y - cy
                    local d = dx * dx + dy * dy
                    if not bestD or d < bestD then best, bestD = e, d end
                end
            end
        end
    end
    return best
end

local function rebuildPat(myPos)
    local out = {}
    if not (CFG.hostages or CFG.traders or CFG.bounties) then
        cache.pat = out
        return
    end

    local pf = resolve("objects", function()
        local b = Workspace:FindFirstChild("Buildings")
        local l = b and b:FindFirstChild("Loots")
        local o = l and l:FindFirstChild("Objects")
        if o then return o end
        o = b and b:FindFirstChild("Objects")
        if o then return o end
        return Workspace:FindFirstChild("Objects")
    end)
    if not pf then cache.pat = out return end

    local ok, kids = pcall(function() return pf:GetChildren() end)
    if not (ok and kids) then cache.pat = out return end

    local rng = CFG.patRange * CFG.patRange
    for _, o in ipairs(kids) do
        local nm = o.Name or ""
        local ln = nm:lower()
        local tag, show

        if CFG.hostages and ln:find("hostage", 1, true) then
            tag, show = "HOSTAGE", nm
        elseif ln:find("bountyposter", 1, true) then
            if CFG.bounties then
                tag = "BOUNTY"
                show = nm:match("^[bB]ountyPoster%-(.+)%-[%d%.]+$") or nm
            end
        elseif CFG.traders then
            tag, show = "TRADER", nm
        end

        if tag then
            local root = o
            local rp
            pcall(function() rp = o.Position end)
            if not rp then
                root = o:FindFirstChildWhichIsA("BasePart")
                if root then pcall(function() rp = root.Position end) end
            end
            if root and rp then
                do
                    local dx, dy, dz = rp.X-myPos.X, rp.Y-myPos.Y, rp.Z-myPos.Z
                    local q = dx*dx + dy*dy + dz*dz
                    if q <= rng then
                        out[#out + 1] = { pos = rp, q = q, name = show, tag = tag }
                    end
                end
            end
        end
    end

    table.sort(out, function(a, b) return a.q < b.q end)
    for i = #out, 31, -1 do out[i] = nil end
    cache.pat = out
end

