local function checkLootAlerts()
    if not CFG.alertsEnabled then return end
    local ch = LocalPlayer and LocalPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local lf = getLootsFolder()
    local items = lf and lf:FindFirstChild("Items")
    if not hrp or not items then return end
    local maxSq = CFG.alertDist * CFG.alertDist
    local now = tick()
    local sent = 0
    local ok, kids = pcall(function() return items:GetChildren() end)
    if not ok or not kids then return end
    for _, it in ipairs(kids) do
        local tier = ITEM_TIER[it.Name]
        if tier and alertTier(tier) then
            local root = it:FindFirstChildWhichIsA("BasePart")
            if root and root.Parent then
                local pos = root.Position
                local d = pos - hrp.Position
                local dsq = d.X*d.X + d.Y*d.Y + d.Z*d.Z
                if dsq <= maxSq then
                    local key = it.Name.."@"..floor(pos.X/4)..","..floor(pos.Y/4)..","..floor(pos.Z/4)
                    if not alerted[key] or now - alerted[key] >= CFG.alertCooldown then
                        alerted[key] = now
                        if sent < 3 then
                            sent = sent + 1
                            notify("Rare Loot", it.Name.." ["..floor(sqrt(dsq)).."m]", 4, "good")
                        end
                    end
                end
            end
        end
    end
    local cut = (CFG.alertCooldown or 20) * 2
    for k, t in pairs(alerted) do if now - t > cut then alerted[k] = nil end end
end

local pAlertTimes = {}
local function checkPlayerAlerts()
    if not CFG.playerAlertEnabled then return end
    local ch = LocalPlayer and LocalPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
