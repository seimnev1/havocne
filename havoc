local bossCache = {}
task.spawn(function()
    while S.alive do
        local ch = LocalPlayer and LocalPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local found = {}
        if hrp then
            for _, e in ipairs(entObjects) do
                if BOSS_NAMES[e.label] then
                    local hp = e.hum and e.hum.Health or nil
                    found[e.label] = { dist = floor(sqrt(e._dsq or 0)),
                                       alive = (hp == nil) or (hp > 0) }
                end
            end
            local ok, objF = pcall(function() return Workspace.Buildings.Loots.Objects end)
            if ok and objF then
                local ok2, kids = pcall(function() return objF:GetChildren() end)
                if ok2 and kids then
                    for _, m in ipairs(kids) do
                        if BOSS_NAMES[m.Name] and not found[m.Name] then
                            local p = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso")
                            if p and p.Parent and p.Position then
                                local d = p.Position - hrp.Position
                                local hum = m:FindFirstChild("Humanoid")
                                local hp = hum and hum.Health or nil
                                found[m.Name] = {
                                    dist = floor(sqrt(d.X*d.X + d.Y*d.Y + d.Z*d.Z)),
                                    alive = (hp == nil) or (hp > 0) }
                            end
                        end
                    end
                end
            end
        end
        local rows = {}
        for name in pairs(BOSS_NAMES) do rows[#rows+1] = name end
        table.sort(rows)
        local out = {}
        for _, name in ipairs(rows) do
            local f = found[name]
            if f and f.alive then
                out[#out+1] = { left = name, right = f.dist .. "m",
                                color = T.good, rightColor = T.good }
                if bossCache[name] ~= "alive" then
                    notify("Boss Alive", name .. " [" .. f.dist .. "m]", 6, "bad")
                end
                bossCache[name] = "alive"
            else
                out[#out+1] = { left = name, right = "Dead",
                                color = T.textDim, rightColor = T.bad }
                bossCache[name] = "dead"
            end
        end
        pBoss:Set(out)

        local lrows = {}
        for i = 1, minf(6, #lootObjects) do
            local e = lootObjects[i]
            local d = floor(sqrt(e._dsq or 0))
            lrows[#lrows+1] = { left = e.name, right = d .. "m", color = e.color }
        end
        if #lrows == 0 then
            lrows[1] = { left = "  (no loot tracked)", color = T.textDim }
        end
        local lt = "Loot Finder [" .. #lootObjects .. "]"
        if pLoot.title ~= lt then pLoot.title = lt; pLoot.titleT.Text = lt end
        pLoot:Set(lrows)

        local srows, scount = {}, 0
        for _, p in ipairs(Players:GetPlayers()) do
            local nm
            local okn = pcall(function() nm = p.Name end)
            if okn and nm then
                local role = S:StaffRole(nm)
                if role then
                    scount = scount + 1
                    srows[#srows + 1] = { left = nm, right = role,
                                          color = T.bad, rightColor = T.bad }
                    S:StaffAlert(nm)
                end
            end
        end
        if scount == 0 then
            srows[1] = { left = "  no mods in server", color = T.good }
        end
        local st = (scount > 0) and ("Mod Check [" .. scount .. "]") or "Mod Check"
        if pStaff.title ~= st then pStaff.title = st; pStaff.titleT.Text = st end
        pStaff:Set(srows)

        local d = S.wlDrop
        if d then
            local keep = (d.options[d.index] or ""):gsub(" %[WL%]$", "")
            local names = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local nm = p.Name
                    names[#names + 1] = _wl[nm:lower()] and (nm .. " [WL]") or nm
                end
            end
            table.sort(names)
            if #names == 0 then names = { "(no players)" } end
            d.options = names
            d.index = 1
            for i, n in ipairs(names) do
                if n:gsub(" %[WL%]$", "") == keep then d.index = i break end
            end
            d.cache.v = nil   -- force the box text to refresh
        end

        task.wait(1)
    end
end)

