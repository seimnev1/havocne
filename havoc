local function newTx()
    local o = born(Drawing.new("Text"))
    prop(o, "Size", 13)
    prop(o, "Center", false)
    prop(o, "Outline", true)
    prop(o, "Font", ESP_FONTS[espFontName])
    o.Visible = false
    return o
end
local function newLn()
    local o = born(Drawing.new("Line"))
    prop(o, "Thickness", 1)
    o.Visible = false
    return o
end

local function box(x, y, w, h, col, z, a, filled, corner)
    used.s = used.s + 1
    local o = pool.s[used.s]
    if not o then o = newSq(); pool.s[used.s] = o end
    local p, s = V2(floor(x), floor(y)), V2(floor(w), floor(h))
    if o.Position ~= p then o.Position = p end
    if o.Size ~= s then o.Size = s end
    if o.Color ~= col then o.Color = col end
    local fl = filled ~= false
    if o.Filled ~= fl then o.Filled = fl end
    if o.ZIndex ~= z then o.ZIndex = z end
    local tr = a or 1
    if o.Transparency ~= tr then o.Transparency = tr end
    if corner then pcall(function() o.Corner = corner end) end
    o.Visible = true
    return o
end

local function say(str, x, y, col, z, size, centre, a)
    used.t = used.t + 1
    local o = pool.t[used.t]
    if not o then o = newTx(); pool.t[used.t] = o end
    str = tostring(str)
    if o.Text ~= str then o.Text = str end
    local sz = size or 13
    if o.Size ~= sz then prop(o, "Size", sz) end
    local ce = centre == true
    if o.Center ~= ce then prop(o, "Center", ce) end
    local p = V2(floor(x), floor(y))
    if o.Position ~= p then o.Position = p end
    if o.Color ~= col then o.Color = col end
    if o.ZIndex ~= z then o.ZIndex = z end
    local tr = a or 1
    if o.Transparency ~= tr then o.Transparency = tr end
    o.Visible = true
    return o
end

local function ln(x1, y1, x2, y2, col, z, a, th)
    used.l = used.l + 1
    local o = pool.l[used.l]
    if not o then o = newLn(); pool.l[used.l] = o end
    o.From = V2(floor(x1), floor(y1))
    o.To = V2(floor(x2), floor(y2))
    if o.Color ~= col then o.Color = col end
    if o.ZIndex ~= z then o.ZIndex = z end
    local tr = a or 1
    if o.Transparency ~= tr then o.Transparency = tr end
    local t2 = th or 1
    if o.Thickness ~= t2 then o.Thickness = t2 end
    o.Visible = true
    return o
end

P.invText = {}
P.invUsed = 0
P.invFace = ESP_FONTS[espFontName]

local function invSay(str, x, y, col, z, size, centre)
    P.invUsed = P.invUsed + 1
    local o = P.invText[P.invUsed]
    if not o then
        o = born(Drawing.new("Text"))
        prop(o, "Outline", true)
        prop(o, "Font", P.invFace)
        o.Visible = false
        P.invText[P.invUsed] = o
    end

    str = tostring(str)
    if o.Text ~= str then o.Text = str end
    local sz = size or 11
    if o.Size ~= sz then prop(o, "Size", sz) end
    local ce = centre == true
    if o.Center ~= ce then prop(o, "Center", ce) end
    local p = V2(floor(x), floor(y))
    if o.Position ~= p then o.Position = p end
    if o.Color ~= col then o.Color = col end
    if o.ZIndex ~= z then o.ZIndex = z end
    o.Transparency = 1
    o.Visible = true
    return o
end

local function invSweep()
    for i = P.invUsed + 1, #P.invText do
        P.invText[i].Visible = false
    end
    P.invUsed = 0
end

--- Match the inventory panel to a named face, applying it to objects that
--- already exist so the change is immediate.
local function setInvFont(name)
    local face = ESP_FONTS[name]
    if face == nil then return false end
    P.invFace = face
    for i = 1, #P.invText do
        prop(P.invText[i], "Font", face)
    end
    return true
end

local function setEspFont(name)
    if not ESP_FONTS[name] then return false end
    espFontName = name
    for i = 1, #pool.t do
        prop(pool.t[i], "Font", ESP_FONTS[name])
    end
    return true
end

local function sweep()
    for i = used.s + 1, #pool.s do pool.s[i].Visible = false end
    for i = used.t + 1, #pool.t do pool.t[i].Visible = false end
    for i = used.l + 1, #pool.l do pool.l[i].Visible = false end
end

local function estW(s, size) return #tostring(s) * size * 0.55 end
local function widthOf(o, s, size)
    local w
    pcall(function() w = o.TextBounds and o.TextBounds.X end)
    if not w or w < 1 then w = #s * size * 0.55 end
    return w
end

local VX, VY = 1600, 900
local function viewport()
    pcall(function()
        local vp = Camera and Camera.ViewportSize
        if vp and vp.X > 0 then VX, VY = vp.X, vp.Y end
    end)
end
