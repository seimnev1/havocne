function Window:Background(opts)
    if not opts then
        hideOtherImages(nil)
        self.bg = nil
        UI._forceDraw = true
        return self
    end

    local src = opts.url or opts.file
    if not src then return self end

    self.bg = {
        src = src,
        alpha = opts.alpha or 0.22,
        scrim = opts.scrim or 0.55,
        rounding = opts.rounding or 10,

        aspect = opts.aspect,
        fit = opts.fit or (opts.aspect and "contain" or "stretch"),
        obj = nil,
    }

    local data = fetchImage(src, opts.cache)

    if data then
        local kind, size = imageKind(data)
        self.bgKind = kind
        if kind ~= "PNG" then
            UI:Notify {
                title = "Background is " .. kind,
                text = "PNG is the safe format. Convert and retry.",
                kind = "warn", duration = 6,
            }
        end
        self.bg.obj = makeImage(src, data, self.bg.rounding)
        if self.bg.obj then
            self.bg.info = kind .. "  " .. floor(size / 1024) .. " KB"
        end
    else
        UI:Notify { title = "Background", text = "No image data at that path",
                    kind = "bad" }
    end

    if not self.bg.obj then
        UI:Notify { title = "Background",
                    text = "Host rejected the image data", kind = "bad" }
        self.bg = nil
    end

    hideOtherImages(self.bg and self.bg.obj or nil)

    UI._forceDraw = true
    return self
end

function Window:BackgroundInfo()
    return self.bg and self.bg.info or nil
end

function Window:SetBackgroundAlpha(v)
    if self.bg then self.bg.alpha = clamp(v, 0, 1); UI._forceDraw = true end
    return self
end

function Window:SetBackgroundScrim(v)
    if self.bg then self.bg.scrim = clamp(v, 0, 1); UI._forceDraw = true end
    return self
end

function Window:Toggle(state)
    self.open = (state == nil) and not self.open or state
    return self
end

local function widgetHeight(w)
    if w.kind == "slider" then return SLIDER_H end
    if w.kind == "file" then return ROW_H end
    if w.kind == "list" then return w.height * 20 + 14 end
    if w.kind == "search" then return 32 end
    if w.kind == "label" then return 18 end
    return ROW_H
end

local function sectionHeight(s)
    local h = (s.subtitle and 40 or 30) + SECTION_PAD
    for _, w in ipairs(s.widgets) do h = h + widgetHeight(w) end
    return h
end

local function drawSection(win, s, x, y, width, mx, my, Z, alpha, clipTop, clipBot)
    local T, A = State.theme, State.accent
    local h = sectionHeight(s)

    clipTop = clipTop or -1e6
    clipBot = clipBot or 1e6

    -- Entirely outside the visible band: consume the height and draw nothing,
    -- so its widgets also register no click regions.
    if y + h < clipTop or y > clipBot then return h end

    local cardY = max(y, clipTop)
    local cardH = min(y + h, clipBot) - cardY
    if cardH <= 2 then return h end

    shadow(x, cardY, width, cardH, Z - 1, alpha, 6)
    local crad = T.corner and 12 or 6
    rect(x, cardY, width, cardH, T.card, Z,
         (T.cardMul or (Glass.enabled and 0.72 or 0.9)) * alpha, true, crad)
    glassify(x, cardY, width, cardH, Z, alpha, crad)
    rect(x, cardY, width, cardH, T.hair, Z + 1,
         (T.light and 0.22 or 0.45) * alpha, false, crad)

    if y + 30 > clipTop and y < clipBot then
        rect(x + 12, y + 10, 2, s.subtitle and 22 or 14, A, Z + 2, alpha, true, 1)
        local textX = x + 22
        text(s.title, textX, y + 8, T.text, Z + 3, 12, false, alpha)
        if s.subtitle then
            text(s.subtitle, textX, y + 22, T.dim, Z + 3, 9, false, alpha)
        end
    end

    local wy = y + (s.subtitle and 40 or 30)
    for _, w in ipairs(s.widgets) do
        local wh = widgetHeight(w)
        local kind = (wy + wh >= clipTop and wy <= clipBot) and w.kind or nil
        if kind == nil then
            wy = wy + wh
        elseif kind == "toggle" then
            wy = wy + Widget.toggle(w, x, wy, width, mx, my, Z + 3, alpha)
        elseif kind == "slider" then
            wy = wy + Widget.slider(w, x, wy, width, mx, my, Z + 3, alpha, win.drag)
        elseif kind == "dropdown" then
            wy = wy + Widget.dropdown(w, x, wy, width, mx, my, Z + 3, alpha, win.dropdown)
        elseif kind == "button" then
            wy = wy + Widget.button(w, x, wy, width, mx, my, Z + 3, alpha)
        elseif kind == "keybind" then
            wy = wy + Widget.keybind(w, x, wy, width, mx, my, Z + 3, alpha)
        elseif kind == "search" then
            wy = wy + Widget.search(w, x, wy, width, mx, my, Z + 3, alpha)
        elseif kind == "colour" then
            wy = wy + Widget.colour(w, x, wy, width, mx, my, Z + 3, alpha, win.picker)
        elseif kind == "list" then
            if w.get then
                local ok, res = pcall(w.get)
                w.rows = (ok and res) or {}
            end
            wy = wy + Widget.list(w, x, wy, width, mx, my, Z + 3, alpha, win.list)
        elseif kind == "file" then
            wy = wy + Widget.file(w, x, wy, width, mx, my, Z + 3, alpha, win.browser)
        elseif kind == "label" then
            wy = wy + Widget.label(w, x, wy, width, Z + 3, alpha)
        end
    end
    return h
end

local DROP_MAX = 9

local function drawDropdownList(win, mx, my, Z, alpha, bounds)
    local d = win.dropdown
    if not (d.widget and d.rect) then return end

    local T, A = State.theme, State.accent
    local w = d.widget
    local rowH = 19
    local count = #w.options
    local shown = min(count, DROP_MAX)
    local over = count - shown

    w.scroll = clamp(w.scroll or 0, 0, over)

    if not w.scrolled then
        for i, opt in ipairs(w.options) do
            if opt == w.value then
                w.scroll = clamp(i - floor(shown / 2), 0, over)
                break
            end
        end
        w.scrolled = true
    end

    local h = shown * rowH + 6 + (over > 0 and 18 or 0)
    local x, y = d.rect.x, d.rect.y

    if y + h > VY - 8 then y = max(8, VY - 8 - h) end

    region(0, 0, VX, VY, function()
        win.dropdown.widget = nil
        w.scrolled = false
    end)

    shadow(x, y, d.rect.w, h, Z, alpha, 5)
    rect(x, y, d.rect.w, h, T.panel, Z + 1, alpha, true, 5)
    rect(x, y, d.rect.w, h, T.hair, Z + 2, 0.9 * alpha, false, 5)

    for i = 1, shown do
        local opt = w.options[i + w.scroll]
        if opt then
            local iy = y + 3 + (i - 1) * rowH
            local selected = w.value == opt
            local hovered = inside(mx, my, x + 2, iy, d.rect.w - 4, rowH)

            if selected then
                rect(x + 2, iy, d.rect.w - 4, rowH, A, Z + 3, 0.25 * alpha, true, 3)
            elseif hovered then
                rect(x + 2, iy, d.rect.w - 4, rowH, T.card, Z + 3, 0.9 * alpha, true, 3)
            end
            text(opt, x + 9, iy + 3,
                 (selected or hovered) and T.text or T.mid, Z + 5, 10, false, alpha)

            region(x + 2, iy, d.rect.w - 4, rowH, function()
                w.value = opt
                win.dropdown.widget = nil
                w.scrolled = false
                if w.callback then pcall(w.callback, opt) end
            end)
        end
    end

    if over > 0 then
        local by = y + h - 17
        local upHot = inside(mx, my, x + 2, by, 24, 15)
        local dnHot = inside(mx, my, x + d.rect.w - 26, by, 24, 15)

        rect(x + 2, by, 24, 15, T.card, Z + 3,
             (upHot and 0.95 or 0.5) * alpha, true, 3)
        rect(x + d.rect.w - 26, by, 24, 15, T.card, Z + 3,
             (dnHot and 0.95 or 0.5) * alpha, true, 3)

        local uc = upHot and T.text or T.mid
        local dc = dnHot and T.text or T.mid
        line(x + 10, by + 9, x + 14, by + 5, uc, Z + 5, alpha, 1.4)
        line(x + 14, by + 5, x + 18, by + 9, uc, Z + 5, alpha, 1.4)
        line(x + d.rect.w - 18, by + 5, x + d.rect.w - 14, by + 9, dc, Z + 5, alpha, 1.4)
        line(x + d.rect.w - 14, by + 9, x + d.rect.w - 10, by + 5, dc, Z + 5, alpha, 1.4)

        text((w.scroll + 1) .. "-" .. (w.scroll + shown) .. " of " .. count,
             x + d.rect.w * 0.5, by + 2, T.dim, Z + 5, 9, true, alpha)

        region(x + 2, by, 24, 15, function()
            w.scroll = max(0, w.scroll - shown)
        end)
        region(x + d.rect.w - 26, by, 24, 15, function()
            w.scroll = min(over, w.scroll + shown)
        end)
    end
end

function animColour(key, target)
    local r = Anim:to(key .. "r", target.R * 255, 14)
    local g = Anim:to(key .. "g", target.G * 255, 14)
    local b = Anim:to(key .. "b", target.B * 255, 14)
    return rgb(floor(r), floor(g), floor(b))
end

local function gradientBar(x, y, w, h, z, alpha, steps, colourAt, corner)
    local seg = w / steps
    for i = 0, steps - 1 do
        rect(x + i * seg, y, seg + 1.2, h, colourAt(i / (steps - 1)),
             z, alpha, true, (i == 0 or i == steps - 1) and corner or nil)
    end
end

local function drawPicker(win, mx, my, Z, alpha)
    local p = win.picker
    if not (p.widget and p.rect) then return end

    local T, A = State.theme, State.accent
    local w = p.widget

    w.h = w.h or 0.55
    w.s = w.s or 0.7
    w.v = w.v or 1

    local grow = Anim:to("pk" .. w.id, 1, 18)
    local ea = Ease.outQuint(clamp(grow, 0, 1))
    local pa = alpha * ea

    local pw, ph = 172, 108
    local sw2 = lerp(0.96, 1, ea)
    local pwS, phS = floor(pw * sw2), floor(ph * sw2)
    local x = p.rect.x + floor((pw - pwS) / 2)
    local y = p.rect.y + floor((1 - ea) * 6)

    region(0, 0, VX, VY, function()
        win.picker.widget = nil
        Anim.values["pk" .. w.id] = nil
    end)

    shadow(x, y, pwS, phS, Z, pa, 7)
    rect(x, y, pwS, phS, T.panel, Z + 1, pa, true, 7)
    rect(x, y, pwS, phS, T.hair, Z + 2, 0.9 * pa, false, 7)

    local ah = Anim:to("ph" .. w.id, w.h, 20)
    local as = Anim:to("ps" .. w.id, w.s, 20)
    local av = Anim:to("pv" .. w.id, w.v, 20)

    local hx, hy, hw = x + 12, y + 12, pwS - 24
    gradientBar(hx, hy, hw, 14, Z + 3, pa, 64,
        function(t) return hsv(t, 1, 1) end, 3)
    local hkx = hx + ah * hw
    rect(hkx - 1.5, hy - 3, 3, 20, State.white, Z + 5, pa, true, 2)
    rect(hkx - 0.5, hy - 2, 1, 18, hsv(ah, 1, 1), Z + 6, pa, true, 1)
    region(hx - 4, hy - 4, hw + 8, 22, function()
        w.h = clamp((mx - hx) / hw, 0, 1)
        w.value = hsv(w.h, w.s, w.v)
        win.pickerDrag = { widget = w, key = "h", x = hx, w = hw }
        if w.callback then pcall(w.callback, w.value) end
    end)

    local function ramp(label, key, ny, colourAt)
        text(label, x + 12, ny - 1, T.dim, Z + 4, 9, false, pa)
        local bx = x + 40
        local bw = pwS - 40 - 46
        gradientBar(bx, ny, bw, 9, Z + 3, pa, 32, colourAt, 2)
        rect(bx, ny, bw, 9, T.hair, Z + 4, 0.5 * pa, false, 2)
        local kv = (key == "s") and as or av
        rect(bx + bw * kv - 3, ny - 3, 6, 15, State.white, Z + 5, pa, true, 2)
        region(bx - 5, ny - 4, bw + 10, 17, function()
            w[key] = clamp((mx - bx) / bw, 0, 1)
            w.value = hsv(w.h, w.s, w.v)
            win.pickerDrag = { widget = w, key = key, x = bx, w = bw }
            if w.callback then pcall(w.callback, w.value) end
        end)
    end
    ramp("SAT", "s", y + 40, function(t) return hsv(ah, t, av) end)
    ramp("VAL", "v", y + 62, function(t) return hsv(ah, as, t) end)

    local preview = animColour("pv" .. w.id .. "c", w.value)
    rect(x + pwS - 40, y + 40, 28, 31, preview, Z + 4, pa, true, 5)
    rect(x + pwS - 40, y + 40, 28, 31, T.hair, Z + 5, pa, false, 5)

    local closeHot = inside(mx, my, x + 10, y + phS - 20, 44, 16)
    text("close", x + 14, y + phS - 18, closeHot and T.text or T.dim,
         Z + 4, 9, false, pa)
    region(x + 10, y + phS - 20, 44, 16, function()
        win.picker.widget = nil
        Anim.values["pk" .. w.id] = nil
    end)
end

local function drawBrowser(win, mx, my, Z, alpha, bounds)
    local b = win.browser
    if not b.widget then return end

    local T, A = State.theme, State.accent
    local w = b.widget
    local pw, ph = 264, 232
    local x = clamp(bounds.x + bounds.w - pw - 20, 10, VX - pw - 10)
    local y = clamp(bounds.y + 90, 10, VY - ph - 10)

    local grow = Anim:to("br" .. w.id, 1, 18)
    local ea = Ease.outQuint(clamp(grow, 0, 1))
    local pa = alpha * ea

    region(0, 0, VX, VY, function()
        win.browser.widget = nil
        Anim.values["br" .. w.id] = nil
    end)

    shadow(x, y, pw, ph, Z, pa, 7)
    rect(x, y, pw, ph, T.panel, Z + 1, pa, true, 7)
    rect(x, y, pw, ph, T.hair, Z + 2, 0.9 * pa, false, 7)

    local cwd = w.cwd or ""
    local label = cwd == "" and "workspace" or cwd
    text(label, x + 12, y + 9, T.text, Z + 4, 11, false, pa)

    if cwd ~= "" then
        local uh = inside(mx, my, x + pw - 40, y + 6, 30, 18)
        text("up", x + pw - 32, y + 9, uh and T.text or T.dim, Z + 4, 11, false, pa)
        region(x + pw - 40, y + 6, 30, 18, function()
            w.cwd = parentOf(cwd)
            w.scroll = 0
        end)
    end
    line(x + 10, y + 28, x + pw - 10, y + 28, T.hair, Z + 3, 0.6 * pa, 1)

    if w.listedFor ~= cwd then
        w.folders, w.files = listDir(cwd)
        w.listedFor = cwd
    end

    local rows = {}
    for _, p in ipairs(w.folders or {}) do rows[#rows + 1] = { p, true } end
    for _, p in ipairs(w.files or {}) do
        local ext = extOf(p)
        local wanted = (not w.filter) or w.filter[ext]
        if wanted or w.showAll then
            rows[#rows + 1] = { p, false, wanted }
        end
    end

    local ly, lh = y + 34, ph - 44
    local rowH2 = 19
    local vis = floor(lh / rowH2)
    local over = max(0, #rows - vis)
    w.scroll = clamp(w.scroll or 0, 0, over)

    region(x + 6, ly, pw - 18, lh, function()
        win.browserDrag = { widget = w, y0 = my, s0 = w.scroll,
                            over = over, rowH = rowH2, moved = false }
    end)

    for i = 1, min(vis, #rows) do
        local entry = rows[i + w.scroll]
        if entry then
            local path, isDir = entry[1], entry[2]
            local ry = ly + (i - 1) * rowH2
            local hovered = inside(mx, my, x + 6, ry, pw - 18, rowH2)

            local wanted = (entry[3] ~= false)
            local readable = isDir or (READABLE[extOf(path)] and wanted)

            if hovered then
                rect(x + 6, ry, pw - 18, rowH2, T.card, Z + 3, 0.9 * pa, true, 3)
            end

            if isDir then
                rect(x + 14, ry + 7, 9, 6, A, Z + 5, pa, true, 1)
                rect(x + 14, ry + 5, 4, 2, A, Z + 5, pa, true, 1)
            else
                rect(x + 16, ry + 8, 4, 4, readable and T.mid or T.dim,
                     Z + 5, pa, true, 2)
            end

            local colour = isDir and T.text
                or (readable and (hovered and T.text or T.mid) or T.dim)
            text(baseName(path), x + 30, ry + 3, colour, Z + 5, 11, false, pa)

            if not isDir and not readable then
                local note = READABLE[extOf(path)] and "not an image"
                              or "rename to .dat"
                local no = text(note, 0, ry + 4, T.dim, Z + 5, 9, false, 0.8 * pa)
                no.Position = V2(floor(x + pw - 16 - widthOf(no, note, 9)), ry + 4)
            end

            local pRef, dRef, okRef = path, isDir, readable
            region(x + 6, ry, pw - 18, rowH2, function()
                win.browserPend = { widget = w, path = pRef,
                                    isDir = dRef, ok = okRef }
                win.browserDrag = { widget = w, y0 = my, s0 = w.scroll,
                                    over = over, rowH = rowH2, moved = false }
            end)
        end
    end

    if #rows == 0 then
        text("empty folder", x + pw * 0.5, ly + lh * 0.5 - 6,
             T.dim, Z + 5, 11, true, pa)
    end

    if over > 0 then
        local th = max(20, lh * (vis / #rows))
        local tp = ly + (lh - th) * (w.scroll / over)
        rect(x + pw - 9, ly, 3, lh, T.card, Z + 4, pa, true, 2)
        rect(x + pw - 9, tp, 3, th, T.track, Z + 5, pa, true, 2)
    end
end

local function drawWindow(win, mx, my)
    local T, A = State.theme, State.accent

    win.animOpen = Anim:to("win" .. win.id, win.open and 1 or 0, 16)
    local a = Ease.outCubic(clamp(win.animOpen, 0, 1))
    if a < 0.01 then

        if win.bg and win.bg.obj then win.bg.obj.Visible = false end
        return
    end

    local alpha = a
    local scale = lerp(0.985, 1, a)
    local w = floor(win.size.X * scale)
    local h = floor(win.size.Y * scale)
    local x = win.pos.X + floor((win.size.X - w) / 2)
    local y = win.pos.Y + floor((1 - a) * 10)
    local Z = win.z

    local rad = radius(10)
    shadow(x, y, w, h, Z - 2, alpha, rad)
    rect(x, y, w, h, T.shell, Z,
         State.opacity * (T.surface or 1) * alpha, true, rad)

    if win.bg and win.bg.obj and T.light then
        win.bg.obj.Visible = false
    end
    if win.bg and win.bg.obj and not T.light then
        local o = win.bg.obj
        local ix, iy, iw, ih = x, y, w, h

        if win.bg.fit == "contain" and win.bg.aspect then
            local winAspect = w / h
            if winAspect > win.bg.aspect then
                ih = h
                iw = floor(h * win.bg.aspect)
            else
                iw = w
                ih = floor(w / win.bg.aspect)
            end
            ix = x + floor((w - iw) / 2)
            iy = y + floor((h - ih) / 2)
        end

        local pos, size = V2(ix, iy), V2(iw, ih)
        if o.Position ~= pos then o.Position = pos end
        if o.Size ~= size then o.Size = size end
        if o.ZIndex ~= Z + 1 then o.ZIndex = Z + 1 end
        local ia = win.bg.alpha * alpha
        if o.Transparency ~= ia then o.Transparency = ia end
        o.Visible = true
        rect(x, y, w, h, T.shell, Z + 2, win.bg.scrim * alpha, true, 10)
    end

    glassify(x, y, w, h, Z + 2, alpha, rad)
    rect(x, y, w, h, T.hair, Z + 40, (T.light and 0.35 or 0.7) * alpha, false, rad)

    rect(x + 16, y + 15, 3, 13, A, Z + 4, alpha, true, 2)
    local titleObj = text(win.title, x + 26, y + 14, T.text, Z + 4, 13, false, alpha)
    if win.subtitle then
        text(win.subtitle, x + 30 + widthOf(titleObj, win.title, 13), y + 15,
             T.dim, Z + 4, 11, false, alpha)
    end

    region(x, y, w - 30, 36, function()
        win.dragWin = { dx = mx - win.pos.X, dy = my - win.pos.Y }
    end)

    local tx, ty = x + 14, y + 42
    for i, tab in ipairs(win.tabs) do
        local tw = 84
        local active = win.tab == i
        local hovered = inside(mx, my, tx, ty, tw, 24)
        local sel = Anim:to("tab" .. win.id .. i, active and 1 or 0, 18)
        local hv = Anim:to("tbh" .. win.id .. i, hovered and 1 or 0, 18)

        if sel > 0.01 then
            rect(tx, ty, tw, 24, blend(T.card, A, 0.16 * sel), Z + 2,
                 sel * alpha, true, 6)
            rect(tx + 10, ty + 23, tw - 20, 2, A, Z + 4, sel * alpha, true, 1)
        elseif hv > 0.01 then
            rect(tx, ty, tw, 24, T.card, Z + 2, 0.5 * hv * alpha, true, 6)
        end
        text(tab.name, tx + tw * 0.5, ty + 5,
             blend(blend(T.dim, T.mid, hv), T.text, sel), Z + 5, 12, true, alpha)

        local idx = i
        region(tx, ty, tw, 24, function()
            if win.tab ~= idx then
                win.tab = idx
                -- Clear first: the new tab may claim fewer objects than the
                -- old one, and anything left over would linger.
                blankAll()
                UI._forceDraw = true
            end
        end)
        tx = tx + tw + 6
    end
    line(x + 14, y + 72, x + w - 14, y + 72, T.hair, Z + 3, 0.5 * alpha, 1)

    local page = win.tabs[win.tab]
    if page then
        local top = y + 82
        local bot = y + h - 14
        local room = bot - top

        -- Measure both columns first so the scroll range is known before
        -- anything is drawn.
        local need = { 0, 0 }
        for _, s in ipairs(page.sections) do
            local c = clamp(s.column, 1, 2)
            need[c] = need[c] + sectionHeight(s) + 10
        end
        local tallest = max(need[1], need[2]) - 10
        local over = max(0, tallest - room)

        win.scroll = win.scroll or {}
        win.scroll[win.tab] = clamp(win.scroll[win.tab] or 0, 0, over)
        local off = win.scroll[win.tab]

        local colX = { x + 14, x + 14 + (w - 38) / 2 + 10 }
        local colY = { top - off, top - off }
        local colW = (w - 38) / 2
        if over > 0 then colW = colW - 5 end

        if over > 0 then
            local topR, roomR, overR = top, room, over
            region(x + 8, top, w - 24, room, function()
                win.pageDrag = { y0 = my, s0 = off, over = overR, tab = win.tab }
            end)
        end

        for _, s in ipairs(page.sections) do
            local c = clamp(s.column, 1, 2)
            local used = drawSection(win, s, colX[c], colY[c], colW, mx, my,
                                     Z + 5, alpha, top, bot)
            colY[c] = colY[c] + used + 10
        end

        if over > 0 then
            local barX = x + w - 12
            local th = max(28, room * (room / (room + over)))
            local tp = top + (room - th) * (off / over)

            rect(barX, top, 4, room, T.card, Z + 30, 0.6 * alpha, true, 2)
            rect(barX, tp, 4, th, T.track, Z + 31, alpha, true, 2)

            local topR2, roomR2, thR2, overR2 = top, room, th, over
            region(barX - 4, top, 12, room, function()
                win.pageBar = { y = topR2, h = roomR2, t = thR2, over = overR2,
                                tab = win.tab }
            end)
        end
    end

    region(x + w - 24, y + h - 24, 24, 24, function()
        win.resizing = { dx = mx - win.size.X, dy = my - win.size.Y }
    end)

    drawDropdownList(win, mx, my, Z + 60, alpha, { x = x, y = y, w = w, h = h })
    drawPicker(win, mx, my, Z + 60, alpha)
    drawBrowser(win, mx, my, Z + 70, alpha, { x = x, y = y, w = w, h = h })
end

