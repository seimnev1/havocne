local AMT_KEYS = { amount = true, count = true, quantity = true, stack = true,
                   stacksize = true, qty = true, num = true, ammo = true }

--- Stack size for an item, read from attributes then child values.
local function amountOf(it)
    local best
    local function take(v)
        v = tonumber(v)
        if v and v > 0 and (not best or v > best) then best = v end
    end
    pcall(function()
        local at = it:GetAttributes()
        if type(at) == "table" then
            for k, v in pairs(at) do
                if AMT_KEYS[tostring(k):lower()] then take(v) end
            end
        end
    end)
    pcall(function()
        for _, c in ipairs(it:GetChildren()) do
            if AMT_KEYS[tostring(c.Name):lower()] then take(c.Value) end
        end
    end)
    return best
end

local function isMoney(it)
    local ok = false
    pcall(function()
        local t = it:FindFirstChild("itemType")
        if t and tostring(t.Value):lower() == "money" then ok = true return end
        local c = it:FindFirstChild("category")
        if c and tostring(c.Value):lower() == "currency" then ok = true end
    end)
    if ok then return true end
    return tostring(it.Name or ""):lower():find("cash", 1, true) ~= nil
end

--- Read a player's inventory.
---
--- Containers hang off activeInventory as ObjectValues pointing at a folder
--- whose "items" child holds the contents.
local WEAPON_SLOTS = {
    { "primary", "Primary" },
    { "secondary", "Secondary" },
    { "holster", "Holstered" },
    { "hips", "Holstered" },
    { "sling", "Sling" },
    { "melee", "Melee" },
}

--- Match a container name to a weapon slot label, or nil.
local function slotOf(name)
    local ln = tostring(name):lower()
    for _, pair in ipairs(WEAPON_SLOTS) do
        if ln:find(pair[1], 1, true) then return pair[2] end
    end
    return nil
end

--- Equipped weapons are not in the inventory containers on this game, so look
--- for them wherever they might be: values on the player, a loadout folder, or
--- tools on the character.
local function readSlots(plr, char)
    local out = {}
    local seen = {}

    local function add(slot, name)
        if not name or name == "" then return end
        local key = slot .. name
        if seen[key] then return end
        seen[key] = true
        out[#out + 1] = { slot = slot, name = name, tier = tierOf(name) }
    end

    local function valueName(v)
        if type(v) == "string" then return v end
        if typeof and typeof(v) == "Instance" then return v.Name end
        return nil
    end

    pcall(function()
        for _, c in ipairs(plr:GetChildren()) do
            local slot = slotOf(c.Name)
            if slot then
                local okv, val = pcall(function() return c.Value end)
                local nm = okv and valueName(val) or nil
                if nm then
                    add(slot, nm)
                else
                    local items = c:FindFirstChild("items")
                    local kids = items and items:GetChildren()
                    if kids and kids[1] then add(slot, kids[1].Name) end
                end
            end
        end
    end)

    pcall(function()
        for _, folderName in ipairs({ "Loadout", "Equipped", "Weapons", "Gear" }) do
            local fdr = plr:FindFirstChild(folderName)
            if fdr then
                for _, c in ipairs(fdr:GetChildren()) do
                    local slot = slotOf(c.Name) or c.Name
                    local okv, val = pcall(function() return c.Value end)
                    add(slot, (okv and valueName(val)) or c.Name)
                end
            end
        end
    end)

    pcall(function()
        if not char then return end
        for _, c in ipairs(char:GetChildren()) do
            if c.ClassName == "Tool" then add("Held", c.Name) end
        end
    end)

    return out
end

local function readInventory(plr)
    local rows, total, cash = {}, 0, 0
    local slots = {}

    pcall(function()
        local ai = plr:FindFirstChild("activeInventory")
        if not ai then return end

        for _, ov in ipairs(ai:GetChildren()) do
            local folder = ov.Value
            local items = folder and folder:FindFirstChild("items")
            if items then
                local kids = items:GetChildren()

                -- Equipped weapons are surfaced separately at the top of the
                -- panel; the slot they live in is the only thing that marks
                -- them, so it is read from the container name.
                local slot = slotOf(ov.Name)
                if slot and kids[1] then
                    slots[#slots + 1] = { slot = slot, name = kids[1].Name,
                                          tier = tierOf(kids[1].Name) }
                end

                if #kids > 0 then
                    rows[#rows + 1] = { head = true,
                                        name = ov.Name .. "  (" .. #kids .. ")" }
                end
                for _, it in ipairs(kids) do
                    total = total + 1
                    local amt = amountOf(it)
                    if isMoney(it) then
                        cash = cash + (amt or 0)
                    end
                    rows[#rows + 1] = {
                        name = it.Name,
                        amount = amt,
                        money = isMoney(it),
                        tier = tierOf(it.Name),
                    }
                end
            end
        end
    end)

    return rows, total, cash, slots
end

