local staffHud

local function staffRows(found)
    if not staffHud then return end
    local rows = staffHud.rows
    for i = #rows, 2, -1 do rows[i] = nil end
    for i = 1, #found do
        rows[#rows + 1] = { text = found[i].name, value = found[i].role }
    end
end

function P.scanStaff()
    if not CFG.staffOn then
        if #P.staffList > 0 then
            P.staffList = {}
            P.staffSeen = {}
            staffRows(P.staffList)
        end
        return
    end

    local found = {}
    local ok, list = pcall(function() return Players:GetPlayers() end)
    if not ok or type(list) ~= "table" then return end

    for i = 1, #list do
        local plr = list[i]
        local nm = plr and plr.Name
        local role = staffOf(nm)
        if role then
            found[#found + 1] = { name = nm, role = role,
                                  rank = STAFF_RANK[role] or 9 }
        end
    end

    table.sort(found, function(a, b)
        if a.rank ~= b.rank then return a.rank < b.rank end
        return a.name:lower() < b.name:lower()
    end)

    local here = {}
    for i = 1, #found do
        here[found[i].name] = true
        if CFG.staffAlert and not P.staffSeen[found[i].name] then
            UI:Notify { title = found[i].role .. " in server",
                        text = found[i].name, kind = "bad" }
        end
    end
    for nm in pairs(P.staffSeen) do
        if not here[nm] then P.staffSeen[nm] = nil end
    end
    for nm in pairs(here) do P.staffSeen[nm] = true end

    P.staffList = found
    staffRows(found)
end

