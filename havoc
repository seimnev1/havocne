local BOSS_NAMES = { Ryze = true, Cervus = true, Boris = true }

local BOSS_LOWER = {}
for name in pairs(BOSS_NAMES) do BOSS_LOWER[#BOSS_LOWER + 1] = name:lower() end

--- Boss match by substring, case-insensitive: a model may be named "Boris",
--- "boris" or "Boris_NPC" depending on the map.
local function isBossName(name)
    local ln = tostring(name or ""):lower()
    if ln == "" then return false end
    for i = 1, #BOSS_LOWER do
        if ln:find(BOSS_LOWER[i], 1, true) then return true end
    end
    return false
end

