}

do
    local DIR = "bg"
    local KNOWN = { "bunny", "clouds", "molang", "waifu", "frieren", "popart" }
    local names, paths, seen = BG.names, BG.paths, {}

    local function add(path, stem)
        if not stem or stem == "" then return end
        local label = stem:sub(1, 1):upper() .. stem:sub(2)
        if seen[label] then return end
        seen[label] = true
        names[#names + 1] = label
        paths[label] = path
    end

    local ok, entries = pcall(listfiles, DIR)
    if ok and type(entries) == "table" then
        for _, p in ipairs(entries) do
            local base = tostring(p):match("[^\\/]+$") or tostring(p)
            local stem, ext = base:match("^(.*)%.([%w]+)$")
            if stem and ext and ext:lower() == "dat" then add(p, stem) end
        end
    end

    if #names == 1 then
        local function exists(path)
            local k, res = pcall(isfile, path)
            if k and type(res) == "boolean" then return res end
            local k2, data = pcall(readfile, path)
            return k2 and type(data) == "string" and #data > 0
        end
        for _, stem in ipairs(KNOWN) do
            local p = DIR .. "/" .. stem .. ".dat"
            if exists(p) then add(p, stem) end
        end
    end
end

