function S:DrawWeather(dt)
    local mode = self.weather or "None"
    local col = self.wColor == "Accent" and T.accent
                or (COLOR_PALETTE[self.wColor or "White"] or COLOR_PALETTE.White)
    local used = 0

    if mode ~= "None" then
        local open = {}
        for _, w in ipairs(self.windows) do
            if w.visible and (w.anim or 1) > 0.5 and (w.colAnim or 1) > 0.8 then
                open[#open + 1] = w
            end
        end
        if #open > 0 then
            local total = floor((self.wIntensity or 40) / 100 * self.PT_MAX)
            local per = maxf(1, floor(total / #open))
            for _, w in ipairs(open) do
                local bx, by = w.x, w.y + 30           -- below the title bar
                local bw, bh = w.w, w.h - 32
                if bh > 24 then
                    for _ = 1, per do
                        used = used + 1
                        if used > self.PT_MAX then break end
                        local p = self.parts[used]
                        if p.v == 0 or p.y > bh then
                            p.fx = math.random()
                            p.y = -math.random() * 20
                            p.ph = math.random() * 6.28
                            if mode == "Snow" then
                                p.v = 18 + math.random() * 30
                                p.sz = 1 + math.random() * 1.8
                                p.drift = 4 + math.random() * 8
                            else
                                p.v = 260 + math.random() * 220
                                p.sz = 6 + math.random() * 6
                                p.drift = 0
                            end
                        end
                        p.y = p.y + p.v * dt
                        local yy = by + p.y
                        if mode == "Snow" then
                            local sway = math.sin(tick() * 0.8 + p.ph) * p.drift
                            local xx = clamp(bx + p.fx * bw + sway, bx + 2, bx + bw - 2)
                            p.dot.Position = Vector2.new(xx, yy)
                            p.dot.Radius = p.sz
                            p.dot.Color = col
                            p.dot.Transparency = 0.5
                            p.dot.ZIndex = w.z + 1
                            p.dot.Visible = true
                            p.ln.Visible = false
                        else
                            local xx = bx + p.fx * bw
                            local y2 = maxf(by, yy - p.sz)
                            setLine(p.ln, xx, yy, xx - 2, y2, col, true)
                            p.ln.Transparency = 0.45
                            p.ln.ZIndex = w.z + 1
                            p.dot.Visible = false
                        end
                    end
                end
            end
        end
    end

    for i = used + 1, self.PT_MAX do
        self.parts[i].dot.Visible = false
        self.parts[i].ln.Visible = false
    end
end

