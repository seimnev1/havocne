local function glassify(x, y, w, h, z, alpha, corner, tint)
    if not Glass.enabled then return end
    local A = tint or State.accent
    local light = State.theme.light

    local bands = 8
    local topA = light and 0.11 or 0.035
    local botA = light and 0.02 or 0.060
    for i = 0, bands - 1 do
        local t = i / (bands - 1)
        local by = y + floor(h * i / bands)
        local bh = floor(h * (i + 1) / bands) - floor(h * i / bands)
        if bh > 0 then

            local c = (i == 0 or i == bands - 1) and corner or nil
            if light then

                rect(x, by, w, bh, State.white, z + 1,
                     lerp(topA, botA, t) * alpha, true, c)
            elseif t < 0.5 then
                rect(x, by, w, bh, State.white, z + 1,
                     topA * (1 - t * 2) * alpha, true, c)
            else
                rect(x, by, w, bh, State.black, z + 1,
                     botA * ((t - 0.5) * 2) * alpha, true, c)
            end
        end
    end

    rect(x + 2, y, w - 4, 1, State.white, z + 2,
         (light and 0.55 or 0.22) * alpha, true, 0)
    rect(x, y + 2, 1, h - 4, State.white, z + 2,
         (light and 0.35 or 0.12) * alpha, true, 0)
    rect(x + 2, y + h - 1, w - 4, 1, light and State.white or State.black, z + 2,
         (light and 0.18 or 0.30) * alpha, true, 0)
    rect(x + w - 1, y + 2, 1, h - 4, light and State.white or State.black, z + 2,
         (light and 0.12 or 0.18) * alpha, true, 0)

    rect(x + 2, y + 1, w - 4, 1, A, z + 2, (light and 0.06 or 0.10) * alpha, true, 0)

    local since = tick() - Glass.sweepAt
    if since < Glass.sweepTime then
        local t = since / Glass.sweepTime
        local eased = Ease.inOut(t)
        local bandX = x - 60 + eased * (w + 120)
        local fade = math.sin(t * math.pi)
        for i = 0, 5 do
            local sliceX = bandX + i * 7
            if sliceX > x and sliceX < x + w - 2 then
                local edge = 1 - math.abs(i - 2.5) / 3
                rect(sliceX, y + 1, 7, h - 2, State.white, z + 3,
                     0.05 * edge * fade * alpha, true, 0)
            end
        end
        Anim.busy = true
    end
end

local function tickGlass()
    if not Glass.enabled then return end
    local now = tick()
    if now - Glass.sweepAt > Glass.sweepEvery then
        Glass.sweepAt = now
        UI._forceDraw = true
    end
end

local function shadow(x, y, w, h, z, alpha, corner)
    rect(x - 2, y - 1, w + 4, h + 5, State.black, z, 0.05 * alpha, true, corner)
    rect(x - 1, y, w + 2, h + 3, State.black, z, 0.07 * alpha, true, corner)
end

local imageCache = {}

local imageObjects = {}

local function hideOtherImages(keep)
    for _, o in pairs(imageObjects) do
        if o ~= keep then pcall(function() o.Visible = false end) end
    end
end

local function readLocalImage(path)
    local data
    pcall(function()
        if isfile and isfile(path) then data = readfile(path) end
    end)
    if data then return data end

    local swapped = tostring(path):gsub("%.[%w]+$", ".dat")
    if swapped ~= path then
        pcall(function()
            if isfile and isfile(swapped) then data = readfile(swapped) end
        end)
    end
    return data
end

local function fetchImage(src, cacheName)
    local key = tostring(src) .. "|" .. tostring(cacheName)
    if imageCache[key] ~= nil then
        return imageCache[key] or nil
    end

    local data
    local isHttp = tostring(src):sub(1, 4) == "http"

    if cacheName then data = readLocalImage(cacheName) end

    if not data then
        if isHttp then
            pcall(function() data = game:HttpGet(src) end)
            if data and cacheName then
                pcall(function() writefile(cacheName, data) end)
            end
        else
            data = readLocalImage(src)
        end
    end

    imageCache[key] = data or false
    return data
end

local function imageKind(data)
    if type(data) ~= "string" or #data < 4 then return "unknown", 0 end
    local b1, b2, b3, b4 = data:byte(1, 4)

    if b1 == 0x89 and b2 == 0x50 and b3 == 0x4E and b4 == 0x47 then
        return "PNG", #data
    end
    if b1 == 0xFF and b2 == 0xD8 and b3 == 0xFF then
        return "JPEG", #data
    end
    if b1 == 0x42 and b2 == 0x4D then return "BMP", #data end
    if b1 == 0x47 and b2 == 0x49 and b3 == 0x46 then return "GIF", #data end
    if b1 == 0x52 and b2 == 0x49 and b3 == 0x46 and b4 == 0x46 then
        return "WEBP", #data
    end
    return "unknown", #data
end

local function makeImage(key, data, rounding)
    if imageObjects[key] then
        setProp(imageObjects[key], "Rounding", rounding or 0)
        return imageObjects[key]
    end

    local o
    local ok = pcall(function()
        o = Drawing.new("Image")
        o.Data = data
        o.Visible = false
    end)
    if not ok or not o then return nil end

    setProp(o, "Rounding", rounding or 0)
    tracked[#tracked + 1] = o
    imageObjects[key] = o
    return o
end

