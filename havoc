local Keyboard = { held = {}, downAt = {}, lastRepeat = 0 }

function Keyboard:edge(vk, repeats)
    local now = tick()
    local down = keyDown(vk)
    local was = self.held[vk]
    self.held[vk] = down

    if down and not was then
        self.downAt[vk] = now
        return true
    end
    if down and repeats and self.downAt[vk] and now - self.downAt[vk] > 0.4 then
        if now - self.lastRepeat > 0.045 then
            self.lastRepeat = now
            return true
        end
    end
    if not down then self.downAt[vk] = nil end
    return false
end

function Keyboard:capture(field)
    local changed = false
    local shift = keyDown(0xA0) or keyDown(0xA1)

    local function insert(ch)
        if field.selectAll then field.value = ""; field.selectAll = false end
        field.value = field.value .. ch
        changed = true
    end

    for vk = 0x41, 0x5A do
        if self:edge(vk) then insert(string.char(shift and vk or vk + 32)) end
    end
    for vk = 0x30, 0x39 do
        if self:edge(vk) then insert(string.char(vk)) end
    end
    if self:edge(0x20) then insert(" ") end
    if self:edge(0xBD) then insert("-") end
    if self:edge(0xBE) then insert(".") end

    if self:edge(0x08, true) then
        if field.selectAll then field.value = ""; field.selectAll = false
        else field.value = field.value:sub(1, -2) end
        changed = true
    end
    if self:edge(0x2E) and field.selectAll then
        field.value = ""; field.selectAll = false; changed = true
    end
    if keyDown(0x11) and self:edge(0x41) then field.selectAll = true end
    if self:edge(0x1B) then field.focused = false; field.selectAll = false end
    if self:edge(0x0D) then field.focused = false; field.selectAll = false end

    return changed
end

local function anyKey()
    for vk = 0x01, 0xFE do
        if vk ~= 0xA0 and vk ~= 0xA1 and keyDown(vk) then return vk end
    end
    return nil
end

local KEY_NAMES = {
    [0x01] = "M1", [0x02] = "M2", [0x04] = "M3", [0x08] = "Back",
    [0x09] = "Tab", [0x0D] = "Enter", [0x10] = "Shift", [0x11] = "Ctrl",
    [0x12] = "Alt", [0x14] = "Caps", [0x1B] = "Esc", [0x20] = "Space",
    [0x21] = "PgUp", [0x22] = "PgDn", [0x23] = "End", [0x24] = "Home",
    [0x25] = "Left", [0x26] = "Up", [0x27] = "Right", [0x28] = "Down",
    [0x2D] = "Ins", [0x2E] = "Del",
}

local function keyName(vk)
    if not vk then return "None" end
    if KEY_NAMES[vk] then return KEY_NAMES[vk] end
    if vk >= 0x30 and vk <= 0x39 then return string.char(vk) end
    if vk >= 0x41 and vk <= 0x5A then return string.char(vk) end
    if vk >= 0x70 and vk <= 0x7B then return "F" .. (vk - 0x6F) end
    return "0x" .. string.format("%X", vk)
end

local Toasts = {}

function UI:Notify(opts)
    opts = opts or {}
    Toasts[#Toasts + 1] = {
        title = opts.title or "Notice",
        body  = opts.text or "",
        kind  = opts.kind or "info",
        life  = opts.duration or 4,
        born  = tick(),
        slide = 0,
    }
    return self
end

local VX, VY = 1600, 900

local function refreshViewport()
    pcall(function()
        local vp = Camera and Camera.ViewportSize
        if vp and vp.X > 0 then VX, VY = vp.X, vp.Y end
    end)
end

local function drawToasts()
    local T = State.theme
    local y = VY - 20
    local i = 1

    while i <= #Toasts do
        local t = Toasts[i]
        local age = tick() - t.born

        if age > t.life then
            table.remove(Toasts, i)
        else

            local slideIn = Ease.outQuint(clamp(age / 0.25, 0, 1))
            local fade = clamp((t.life - age) / 0.4, 0, 1)
            if fade < 1 then Anim.busy = true end
            if slideIn < 1 then Anim.busy = true end

            local w, h = 232, 46
            local x = VX - 20 - w + (1 - slideIn) * (w + 24)
            y = y - h
            local Z = 9000
            local col = Status[t.kind] or Status.info

            shadow(x, y, w, h, Z - 1, fade, 8)
            rect(x, y, w, h, T.panel, Z, State.opacity * fade, true, 8)
            rect(x, y, w, h, T.hair, Z + 1, 0.7 * fade, false, 8)
            rect(x, y + 8, 3, h - 16, col, Z + 2, fade, true, 2)

            text(t.title, x + 14, y + 8, T.text, Z + 3, 12, false, fade)
            text(t.body, x + 14, y + 25, T.dim, Z + 3, 10, false, fade)

            y = y - 8
            i = i + 1
        end
    end
end

local huds = {}
local hudsVisible = true

local Hud = {}
Hud.__index = Hud

function Hud:Row(o)
    o = o or {}
    local row = {
        text = o.text or "",
        value = o.value,
        get = o.get,
        colour = o.colour,
        cache = "",
    }
    self.rows[#self.rows + 1] = row
    return row
end

function Hud:Toggle(state)
    self.visible = (state == nil) and not self.visible or state
    return self
end

function Hud:Remove()
    for i, h in ipairs(huds) do
        if h == self then table.remove(huds, i) break end
    end
end

local function bindRows()
    local out = {}
    for i = 1, #UI._binds do
        local w = UI._binds[i]
        out[#out + 1] = { w.text or "Bind",
                          w.listening and "..." or keyName(w.value) }
    end
    return out
end

local function hudRowText(row)
    if row.get then
        local ok, label, value = pcall(row.get)
        if ok then return tostring(label or ""), value and tostring(value) or nil end
        return "", nil
    end
    return row.text, row.value and tostring(row.value) or nil
end

local function hudChanged()
    local changed = false
    for _, h in ipairs(huds) do
        if h.visible and h.binds then
            local sig = ""
            for i = 1, #UI._binds do
                local w = UI._binds[i]
                sig = sig .. tostring(w.value) .. (w.listening and "!" or "")
            end
            if sig ~= h.bindSig then h.bindSig = sig; changed = true end
        end
        if h.visible then
            for _, row in ipairs(h.rows) do
                local label, value = hudRowText(row)
                local joined = label .. "\1" .. (value or "")
                if joined ~= row.cache then
                    row.cache = joined
                    changed = true
                end
            end
        end
    end
    return changed
end

local function drawHuds(mx, my)
    if not hudsVisible then return end
    local T, A = State.theme, State.accent

    for _, h in ipairs(huds) do
        local shown = Anim:to("hud" .. h.id, h.visible and 1 or 0, 16)
        if shown > 0.01 then
            local alpha = Ease.outCubic(shown)
            local Z = h.z

            local widest = estWidth(h.title, 11) + 24
            local rowTexts = h.binds and bindRows() or {}
            if not h.binds then
                for i, row in ipairs(h.rows) do
                    local label, value = hudRowText(row)
                    rowTexts[i] = { label, value }
                end
            end
            for i = 1, #rowTexts do
                local label, value = rowTexts[i][1], rowTexts[i][2]
                local need = estWidth(label, 11) + 20
                if value then need = need + estWidth(value, 11) + 16 end
                if need > widest then widest = need end
            end
            local w = max(h.minWidth or 120, floor(widest))
            local head = 22
            local hgt = head + #rowTexts * 16 + 8
            local x, y = h.pos.X, h.pos.Y

            shadow(x, y, w, hgt, Z - 1, alpha, 6)
            local hrad = T.corner and 12 or 6
            rect(x, y, w, hgt, T.panel, Z,
                 State.opacity * (T.cardMul or (Glass.enabled and 0.8 or 1)) * alpha,
                 true, hrad)
            glassify(x, y, w, hgt, Z, alpha, hrad)
            rect(x, y, w, hgt, T.hair, Z + 1,
                 (T.light and 0.25 or 0.5) * alpha, false, hrad)

            rect(x + 10, y + 6, 2, 10, A, Z + 2, alpha, true, 1)
            text(h.title, x + 18, y + 4, T.text, Z + 2, 11, false, alpha)

            local ry = y + head
            for i = 1, #rowTexts do
                local row = h.rows[i] or {}
                local label, value = rowTexts[i][1], rowTexts[i][2]
                text(label, x + 10, ry, row.colour or T.mid, Z + 2, 11, false, alpha)
                if value then
                    local vo = text(value, 0, ry, T.text, Z + 2, 11, false, alpha)
                    vo.Position = V2(floor(x + w - 10 - widthOf(vo, value, 11)), ry)
                end
                ry = ry + 16
            end

            local href = h
            region(x, y, w, head, function()
                href.dragging = { dx = mx - href.pos.X, dy = my - href.pos.Y }
            end)
        end
    end
end

local watermark = nil

function UI:Watermark(opts)
    if opts == false then watermark = nil; UI._forceDraw = true; return end
    opts = opts or {}
    watermark = {
        get = opts.get,
        pos = opts.pos,
        centre = opts.pos == nil,
        visible = opts.visible ~= false,
        sig = "",
    }
    UI._forceDraw = true
    return watermark
end

--- Show or hide the watermark without discarding it.
---
--- Destroying it with Watermark(false) would lose the position the user
--- dragged it to, so hiding is a separate flag.
function UI:SetWatermarkVisible(state)
    if not watermark then return false end
    watermark.visible = (state == nil) and not watermark.visible or state
    UI._forceDraw = true
    return watermark.visible
end

function UI:GetWatermarkVisible()
    return watermark ~= nil and watermark.visible ~= false
end

local function drawWatermark(mxNow, myNow)
    if not (watermark and watermark.get) then return end
    if watermark.visible == false then return end
    local ok, parts = pcall(watermark.get)
    if not ok or type(parts) ~= "table" or #parts == 0 then return end

    local T, A = State.theme, State.accent
    local Z = 8000
    local pad, gap = 10, 9

    local widths, total = {}, 0
    for i = 1, #parts do
        widths[i] = estWidth(parts[i], 11)
        total = total + widths[i]
        if i < #parts then total = total + gap * 2 + 1 end
    end

    local w = floor(total + pad * 2)
    local h = 22

    if watermark.centre or not watermark.pos then
        watermark.pos = V2(floor((VX - w) / 2), 8)
        watermark.centre = false
    end

    local x, y = watermark.pos.X, watermark.pos.Y
    watermark.w, watermark.h = w, h

    region(x, y, w, h, function()
        watermark.drag = { dx = mxNow - x, dy = myNow - y }
    end)

    shadow(x, y, w, h, Z - 1, 1, 5)
    rect(x, y, w, h, T.panel, Z, State.opacity, true, 5)
    rect(x, y, w, h, T.hair, Z + 1, 0.6, false, 5)
    rect(x, y, w, 2, A, Z + 2, 0.9, true, 1)

    local cx = x + pad
    for i = 1, #parts do
        text(parts[i], cx, y + 5, i == 1 and A or T.mid, Z + 3, 11)
        cx = cx + widths[i]
        if i < #parts then
            rect(cx + gap, y + 6, 1, h - 12, T.hair, Z + 3, 0.9)
            cx = cx + gap * 2 + 1
        end
    end
end

function UI:Hud(opts)
    opts = opts or {}
    refreshViewport()
    local h = setmetatable({
        id = #huds + 1,
        title = opts.title or "HUD",
        binds = opts.binds,
        pos = opts.pos or V2(20, 20),
        minWidth = opts.minWidth or 120,
        visible = opts.visible ~= false,
        rows = {},
        z = 150 + #huds * 10,
    }, Hud)
    huds[#huds + 1] = h
    return h
end

function UI:SetHudVisible(state)
    hudsVisible = (state == nil) and not hudsVisible or state
    UI._forceDraw = true
    return hudsVisible
end

local animColour

local Widget = {}

local ROW_H = 24
local SLIDER_H = 34
local SECTION_PAD = 8

function Widget.toggle(w, x, y, width, mx, my, Z, alpha)
    local T, A = State.theme, State.accent
    local hovered = inside(mx, my, x, y, width, ROW_H)
    local hv = Anim:to("hv" .. w.id, hovered and 1 or 0, 18)
    local on = Anim:to("tg" .. w.id, w.value and 1 or 0, 20)

    if hv > 0.01 then
        rect(x, y, width, ROW_H, T.card, Z, 0.55 * hv * alpha, true, 5)
        rect(x, y + 5, 2, ROW_H - 10, A, Z + 1, hv * alpha, true, 1)
    end
    text(w.text, x + 10, y + 5, blend(T.mid, T.text, hv), Z + 2, 12, false, alpha)

    local tw, th = 32, 16
    local tx, ty = x + width - tw - 10, y + (ROW_H - th) / 2
    if on > 0.02 then
        rect(tx - 3, ty - 3, tw + 6, th + 6, A, Z + 1, 0.16 * on * hv * alpha, true, 9)
    end
    rect(tx, ty, tw, th, blend(T.track, A, on), Z + 2, alpha, true, 8)
    rect(lerp(tx + 2, tx + tw - 14, on), ty + 2, 12, 12,
         State.white, Z + 3, alpha, true, 6)

    region(x, y, width, ROW_H, function()
        w.value = not w.value
        if w.callback then pcall(w.callback, w.value) end
    end)
    return ROW_H
end

function Widget.slider(w, x, y, width, mx, my, Z, alpha, drag)
    local T, A = State.theme, State.accent
    local hovered = inside(mx, my, x, y, width, SLIDER_H)
    local dragging = drag and drag.widget == w

    text(w.text, x + 10, y + 2, T.mid, Z + 2, 11, false, alpha)

    local shown = w.decimals and string.format("%." .. w.decimals .. "f", w.value)
                  or tostring(floor(w.value + 0.5))
    shown = shown .. (w.suffix or "")
    local vo = text(shown, 0, y + 2, (hovered or dragging) and T.text or T.mid,
                    Z + 2, 11, false, alpha)
    vo.Position = V2(floor(x + width - 10 - widthOf(vo, shown, 11)), y + 2)

    local ty = y + 20
    local tx, tw = x + 10, width - 20
    local pct = clamp((w.value - w.min) / max(0.0001, w.max - w.min), 0, 1)
    local shownPct = Anim:to("sl" .. w.id, pct, 22)

    rect(tx, ty, tw, 5, T.track, Z + 2, alpha, true, 2)
    rect(tx, ty, max(3, tw * shownPct), 5, A, Z + 3, alpha, true, 2)
    local knob = dragging and 9 or 7
    rect(tx + tw * shownPct - knob / 2, ty - 3, knob, 11,
         State.white, Z + 4, alpha, true, 3)

    region(tx - 6, ty - 8, tw + 12, 20, function()
        drag.widget, drag.x, drag.w = w, tx, tw
        w:Set(w.min + (w.max - w.min) * clamp((mx - tx) / tw, 0, 1))
    end)
    return SLIDER_H
end

function Widget.dropdown(w, x, y, width, mx, my, Z, alpha, openState)
    local T, A = State.theme, State.accent
    local hovered = inside(mx, my, x, y, width, ROW_H)
    local hv = Anim:to("hv" .. w.id, hovered and 1 or 0, 18)
    local isOpen = openState.widget == w

    if hv > 0.01 then
        rect(x, y, width, ROW_H, T.card, Z, 0.5 * hv * alpha, true, 5)
    end
    text(w.text, x + 10, y + 5, blend(T.mid, T.text, hv), Z + 2, 12, false, alpha)

    -- Fit the field to its value rather than a fixed fraction of the row, so a
    -- short option does not leave a wide empty box.
    local shown = tostring(w.value)
    local label = estWidth(shown, 11)
    local fw = clamp(label + 34, 62, width * 0.62)
    local fx, fy, fh = x + width - fw - 10, y + 3, ROW_H - 6

    rect(fx, fy, fw, fh, T.card, Z + 2, alpha, true, 4)
    rect(fx, fy, fw, fh, isOpen and A or T.hair, Z + 3,
         isOpen and alpha or 0.7 * alpha, false, 4)

    -- Trim anything that would run under the arrow.
    local room = fw - 32
    while #shown > 3 and estWidth(shown, 11) > room do
        shown = shown:sub(1, #shown - 1)
    end
    if shown ~= tostring(w.value) then shown = shown .. ".." end

    local to = text(shown, fx + 9, fy + (fh - 11) / 2 - 1, T.text, Z + 4, 11,
                    false, alpha)

    -- Small filled triangle, inset from the border and pinned to the vertical
    -- centre of the field so it never rides the edge.
    local flip = Anim:to("dd" .. w.id, isOpen and 1 or 0, 20)
    local cx = fx + fw - 12
    local cy = fy + floor(fh * 0.5)
    local half = 3
    local reach = 2.2
    local top = lerp(cy - reach, cy + reach, flip)
    local tip = lerp(cy + reach, cy - reach, flip)
    local arrow = isOpen and A or blend(T.mid, T.text, hv)
    tri(cx - half, top, cx + half, top, cx, tip, arrow, Z + 5, alpha)

    region(fx, fy, fw, fh, function()
        openState.widget = (openState.widget == w) and nil or w
    end)
    if isOpen then
        openState.rect = { x = fx, y = fy + fh + 3, w = fw }
    end
    return ROW_H
end

function Widget.button(w, x, y, width, mx, my, Z, alpha)
    local T, A = State.theme, State.accent
    local hovered = inside(mx, my, x + 8, y + 2, width - 16, ROW_H - 4)
    local hv = Anim:to("hv" .. w.id, hovered and 1 or 0, 18)

    local bx, by = x + 8, y + 2 - hv
    local bw, bh = width - 16, ROW_H - 4
    rect(bx, by, bw, bh, blend(T.card, T.lift, hv), Z + 2, alpha, true, 5)
    rect(bx, by, bw, bh, blend(T.hair, A, hv), Z + 3, 0.8 * alpha, false, 5)
    text(w.text, bx + bw * 0.5, by + 3, blend(T.mid, T.text, hv),
         Z + 4, 11, true, alpha)

    region(bx, by, bw, bh, function()
        if w.callback then pcall(w.callback) end
    end)
    return ROW_H
end

function Widget.keybind(w, x, y, width, mx, my, Z, alpha)
    local T, A = State.theme, State.accent
    local hovered = inside(mx, my, x, y, width, ROW_H)
    local hv = Anim:to("hv" .. w.id, hovered and 1 or 0, 18)

    if hv > 0.01 then
        rect(x, y, width, ROW_H, T.card, Z, 0.5 * hv * alpha, true, 5)
    end
    text(w.text, x + 10, y + 5, blend(T.mid, T.text, hv), Z + 2, 12, false, alpha)

    local label = w.listening and "..." or keyName(w.value)
    local bw = max(40, estWidth(label, 11) + 18)
    local bx, by = x + width - bw - 10, y + 3
    rect(bx, by, bw, ROW_H - 6, T.card, Z + 2, alpha, true, 4)
    rect(bx, by, bw, ROW_H - 6, w.listening and A or T.hair, Z + 3,
         w.listening and alpha or 0.7 * alpha, false, 4)
    text(label, bx + bw * 0.5, by + 2, w.listening and A or T.text,
         Z + 4, 11, true, alpha)

    if w.listening then
        Anim.busy = true
        local vk = anyKey()
        if vk and vk ~= 0x01 then
            w.value = (vk == 0x1B) and nil or vk
            w.listening = false
            if w.callback then pcall(w.callback, w.value) end
        end
    end

    region(bx, by, bw, ROW_H - 6, function() w.listening = true end)
    return ROW_H
end

function Widget.search(w, x, y, width, mx, my, Z, alpha)
    local T, A = State.theme, State.accent
    local h = 26
    rect(x + 8, y, width - 16, h, T.card, Z + 2, alpha, true, 5)
    rect(x + 8, y, width - 16, h, w.focused and A or T.hair, Z + 3,
         w.focused and alpha or 0.7 * alpha, false, 5)

    local shownText = w.value ~= "" and w.value or (w.placeholder or "Search")
    local to = text(shownText, x + 18, y + 6,
                    w.value ~= "" and T.text or T.dim, Z + 5, 12, false, alpha)
    local tw = w.value ~= "" and widthOf(to, w.value, 12) or 0

    if w.selectAll and w.value ~= "" then
        rect(x + 16, y + 5, tw + 4, 16, A, Z + 4, 0.35 * alpha, true, 2)
    end
    if w.focused and not w.selectAll and (tick() % 1) < 0.5 then
        rect(x + 19 + tw, y + 6, 1, 14, T.text, Z + 6, alpha)
        Anim.busy = true
    end

    region(x + 8, y, width - 42, h, function()
        if w.focused and w.value ~= "" then w.selectAll = true
        else w.focused = true; w.selectAll = false end
    end)

    if w.value ~= "" then
        local cx2, cy2 = x + width - 22, y + 13
        local xh = inside(mx, my, cx2 - 9, cy2 - 9, 18, 18)
        local col = xh and T.text or T.dim
        line(cx2 - 4, cy2 - 4, cx2 + 4, cy2 + 4, col, Z + 5, alpha, 1)
        line(cx2 + 4, cy2 - 4, cx2 - 4, cy2 + 4, col, Z + 5, alpha, 1)
        region(cx2 - 9, cy2 - 9, 18, 18, function()
            w.value = ""; w.selectAll = false
            if w.callback then pcall(w.callback, "") end
        end)
    end
    return h + 6
end

function Widget.colour(w, x, y, width, mx, my, Z, alpha, pickState)
