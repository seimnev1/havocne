function S:CamBasis()
    local cam = Workspace.CurrentCamera
    if not cam or not memory_read then return nil end
    local addr
    pcall(function() addr = cam.Address end)
    if not addr or addr == 0 then return nil end
    local b, ok = {}, true
    for i = 0, 8 do
        local v = memory_read("float", addr + OFF.CAM_ROT + i * 4)
        if type(v) ~= "number" then ok = false break end
        b[i + 1] = v
    end
    if not ok then return nil end
    local rx, ry, rz = b[1], b[4], b[7]
    local lx, ly, lz = -b[3], -b[6], -b[9]
    local rl = rx*rx + ry*ry + rz*rz
    local ll = lx*lx + ly*ly + lz*lz
    if rl < 0.5 or rl > 2 or ll < 0.5 or ll > 2 then return nil end
    return rx, ry, rz, lx, ly, lz
end

function S:DrawArrows(list, myPos, vp, enabled)
    local n = 0
    if enabled and myPos then
        local rx, ry, rz, lx, ly, lz = self:CamBasis()
        if rx then
            local cx, cy = vp.X * 0.5, vp.Y * 0.5
            local radX, radY = vp.X * 0.32, vp.Y * 0.32
            local want = CFG.arrowTarget or "Both"
            for _, e in ipairs(list) do
                if n >= self.ARROW_MAX then break end
                local okKind = (want == "Both")
                    or (want == "Players" and e.isPlayer)
                    or (want == "NPCs" and not e.isPlayer)
                local p = okKind and e.hrp or nil
                local pos = p and p.Parent and p.Position
                if pos then
                    local _, onScreen = WorldToScreen(pos)
                    if not onScreen then
                        local dx, dy, dz = pos.X - myPos.X, pos.Y - myPos.Y, pos.Z - myPos.Z
                        local sx = dx * rx + dy * ry + dz * rz
                        local sz = dx * lx + dy * ly + dz * lz
                        if sx ~= 0 or sz ~= 0 then
                            n = n + 1
                            local a = self.arrows[n]
                            local ang = math.atan2(sx, sz)
                            local ux, uy = math.sin(ang), -math.cos(ang)
                            local px = cx + ux * radX
                            local py = cy + uy * radY
                            local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
                            local sz2 = clamp(16 - dist / 120, 8, 16)
                            local fade = clamp(1 - dist / 900, 0.35, 1)
                            local px2, py2 = -uy, ux          -- perpendicular
                            local tipX, tipY = px + ux * sz2, py + uy * sz2
                            local b1x = px - ux * sz2 * 0.4 + px2 * sz2 * 0.62
                            local b1y = py - uy * sz2 * 0.4 + py2 * sz2 * 0.62
                            local b2x = px - ux * sz2 * 0.4 - px2 * sz2 * 0.62
                            local b2y = py - uy * sz2 * 0.4 - py2 * sz2 * 0.62
                            a.edge.PointA = Vector2.new(tipX, tipY)
                            a.edge.PointB = Vector2.new(b1x, b1y)
                            a.edge.PointC = Vector2.new(b2x, b2y)
                            a.edge.Transparency = fade
                            a.edge.ZIndex = 44; a.edge.Visible = true
                            a.tri.Color = e.isPlayer and selCol(CFG.playerColor)
                                          or selCol(CFG.npcColor)
                            a.tri.PointA = Vector2.new(tipX, tipY)
                            a.tri.PointB = Vector2.new(b1x * 0.985 + tipX * 0.015,
                                                       b1y * 0.985 + tipY * 0.015)
                            a.tri.PointC = Vector2.new(b2x * 0.985 + tipX * 0.015,
                                                       b2y * 0.985 + tipY * 0.015)
                            a.tri.Transparency = fade
                            a.tri.ZIndex = 45; a.tri.Visible = true
                        end
                    end
                end
            end
        end
    end
    for i = n + 1, self.ARROW_MAX do
        self.arrows[i].tri.Visible = false
        self.arrows[i].edge.Visible = false
    end
end

