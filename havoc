-- Names harvested from the world, merged with the static list. The static
-- names do not always match what a map actually calls a container: "Ruined
-- Locker" in the list is "Ruined Weapon Locker" in game.
P.crateSeen = {}
P.crateNames = {}

local function noteCrate(name)
    if not name or P.crateSeen[name] then return end
    P.crateSeen[name] = true
    P.crateNames[#P.crateNames + 1] = name
end

--- Loose name match. Either side may be a substring of the other, so a
--- shortened list entry still matches the full in-game name.
local function crateMatch(objName, wanted)
    if wanted == "All Crates" then return true end
    local a = tostring(objName):lower()
    local b = tostring(wanted):lower()
    if a == b then return true end
    return a:find(b, 1, true) ~= nil or b:find(a, 1, true) ~= nil
end

