local function refreshItems()
    local seen, out = {}, {}
    for nm in pairs(ITEMS) do
        if not seen[nm] then seen[nm] = true; out[#out + 1] = nm end
    end
    local itf = resolve("items", function()
        return Workspace.Buildings.Loots.Items
    end)
    if itf then
        local ok, kids = pcall(function() return itf:GetChildren() end)
        if ok and kids then
            for _, o in ipairs(kids) do
                local nm = o.Name
                if nm and not seen[nm] then seen[nm] = true; out[#out + 1] = nm end
            end
        end
    end
    for nm in pairs(CFG.picked) do
        if not seen[nm] then seen[nm] = true; out[#out + 1] = nm end
    end
    table.sort(out, function(p, q)
        local sp = CFG.picked[p] and 1 or 0
        local sq = CFG.picked[q] and 1 or 0
        if sp ~= sq then return sp > sq end
        local tp = TIER_ORDER[tierOf(p)] or 9
        local tq = TIER_ORDER[tierOf(q)] or 9
        if tp ~= tq then return tp < tq end
        return p:lower() < q:lower()
    end)
    P.itemNames = out
end

local CFG_DIR = "prem_cfg"
local AUTO_FILE = CFG_DIR .. "/autoload.txt"

local DEFAULTS = {}
for k, v in pairs(CFG) do
    if type(v) == "table" then
        local copy = {}
        for k2, v2 in pairs(v) do copy[k2] = v2 end
        DEFAULTS[k] = copy
    else
        DEFAULTS[k] = v
    end
end

local function isColour(v)
    return typeof and typeof(v) == "Color3"
end

local function encodeCFG()
    local out = {}
    for k, v in pairs(CFG) do
        local t = type(v)
        if isColour(v) then
            out[k] = { __c = true,
                       r = floor(v.R * 255 + 0.5),
                       g = floor(v.G * 255 + 0.5),
                       b = floor(v.B * 255 + 0.5) }
        elseif t == "number" or t == "boolean" or t == "string" then
            out[k] = v
        elseif t == "table" then
            local arr = {}
            for name in pairs(v) do arr[#arr + 1] = name end
            table.sort(arr)
            out[k] = { __s = true, list = arr }
        end
    end
    return HttpService:JSONEncode(out)
end

local function decodeCFG(raw)
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok or type(data) ~= "table" then return false end
    for k, v in pairs(data) do
        if type(v) == "table" and v.__c then
            CFG[k] = rgb(v.r or 255, v.g or 255, v.b or 255)
        elseif type(v) == "table" and v.__s then
            local set = {}
            for _, name in ipairs(v.list or {}) do set[name] = true end
            CFG[k] = set
        else
            CFG[k] = v
        end
    end
    return true
end

local function configPath(name) return CFG_DIR .. "/" .. name .. ".json" end

local function configNames()
    local out = {}
    pcall(function()
        if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
        for _, p in ipairs(listfiles(CFG_DIR)) do
            local base = p:match("[^\\/]+$") or p
            local stem = base:match("^(.*)%.json$")
            if stem then out[#out + 1] = stem end
        end
    end)
    table.sort(out)
    return out
end

local function saveConfig(name)
    if not name or name == "" then return false end
    local ok = pcall(function()
        if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
        writefile(configPath(name), encodeCFG())
    end)
    return ok
end

local function loadConfig(name)
    local raw
    local ok = pcall(function()
        if isfile(configPath(name)) then raw = readfile(configPath(name)) end
    end)
    if not ok or not raw then return false end
    if not decodeCFG(raw) then return false end

    -- The engine reads CFG directly, but every control keeps its own copy of
    -- the value, so they have to be told to re-read or the menu shows the old
    -- state while the feature is already running.
    if _G.PREMUI then pcall(function() _G.PREMUI:Sync(CFG) end) end

    -- Values loaded from disk still have to be pushed into the game. The frame
    -- loop picks this up, which avoids depending on definition order here.
    P.reapply = true
    return true
end

local function deleteConfig(name)
    local ok = pcall(function()
        if isfile(configPath(name)) then delfile(configPath(name)) end
    end)
    return ok
end

local function setAutoload(name)
