Anim = { values = {}, busy = false }

function Anim:to(key, target, speed)
    local cur = self.values[key]
    if cur == nil then self.values[key] = target; return target end
    if cur ~= target then
        cur = approach(cur, target, speed)
        self.values[key] = cur
        if cur ~= target then self.busy = true end
    end
    return cur
end

function Anim:get(key, fallback) return self.values[key] or fallback or 0 end

