local function discoverEnts()
    local found = {}

    if Players then
        local ok, list = pcall(function() return Players:GetPlayers() end)
        if ok and list then
            for _, plr in ipairs(list) do
                if plr.Name ~= MYNAME then
                    local ch = plr.Character
                    local root = ch and rootOf(ch)
                    if root and root.Parent then
                        found[#found + 1] = { m = ch, root = root,
                                              name = plr.Name, isPlayer = true,
                                              plr = plr }
                    end
                end
            end
        end
    end

    local seen = {}
    local myChar = me() and LP.Character
    local pname = {}
    pcall(function()
        for _, plr in ipairs(Players:GetPlayers()) do pname[plr.Name] = true end
    end)

    local function tryNPC(m)
        if seen[m] or m == myChar then return end
        if m.ClassName ~= "Model" then return end
        if pname[m.Name] then return end
        local hum = m:FindFirstChild("Humanoid")
        if not hum then return end
        local root = rootOf(m)
        if not (root and root.Parent) then return end
        seen[m] = true
        found[#found + 1] = { m = m, root = root, name = m.Name,
                              isPlayer = false, hum = hum }
    end

    local ok, kids = pcall(function() return Workspace:GetChildren() end)
    if ok and kids then
        for _, cont in ipairs(kids) do
            local cn = cont.ClassName
            if cn == "Folder" or cn == "Model" then
                local ok2, sub = pcall(function() return cont:GetChildren() end)
                if ok2 and sub then
                    for _, c2 in ipairs(sub) do tryNPC(c2) end
                end
            end
        end
    end

    local ok3, objF = pcall(function() return Workspace.Buildings.Loots.Objects end)
    if ok3 and objF then
        local ok4, sub = pcall(function() return objF:GetChildren() end)
        if ok4 and sub then for _, c2 in ipairs(sub) do tryNPC(c2) end end
    end

    P.cand = found
end

local function rebuildEnts(myPos)
    local out = {}
    local rng = CFG.entRange * CFG.entRange
    local cand = P.cand
    local stale = false

    for i = 1, #cand do
        local c = cand[i]
        local root = c.root

        if not (root and root.Parent) then
            if c.plr then
                local ch = c.plr.Character
                root = ch and rootOf(ch)
                if root and root.Parent then
                    c.m, c.root = ch, root
                else
                    stale = true
                end
            else
                stale = true
            end
        end

        if root and root.Parent then
            local isBoss = (not c.isPlayer) and isBossName(c.name)
            local wanted = (c.isPlayer and CFG.players)
                or (isBoss and CFG.bosses)
                or (not c.isPlayer and not isBoss and CFG.npcs)
            if wanted then
                local p = root.Position
                local dx, dy, dz = p.X - myPos.X, p.Y - myPos.Y, p.Z - myPos.Z
                local q = dx * dx + dy * dy + dz * dz
                if q <= rng then
                    local alive = true
                    if c.hum then
                        pcall(function()
                            alive = c.hum.Health > 0 and c.hum.MaxHealth > 0
                        end)
                    end
                    if alive then
                        local plrRef = c.plr
                        local hum = c.hum
                        if not hum then
                            hum = c.m:FindFirstChild("Humanoid")
                            c.hum = hum
                        end
                        if not c.head or not c.head.Parent then
                            c.head = c.m:FindFirstChild("Head")
                        end

                        local tool
                        if CFG.weapon then
                            tool = c.m:FindFirstChildOfClass("Tool")
                        end

                        out[#out + 1] = { m = c.m, root = root, q = q,
                                          name = c.name, isPlayer = c.isPlayer,
                                          isBoss = isBoss,
                                          staff = c.isPlayer and staffOf(c.name) or nil,
                                          plr = plrRef,
                                          hum = hum, head = c.head, tool = tool,
                                          bones = CFG.skeleton and buildBones(c.m) or nil }
                    end
                end
            end
        end
    end

    if stale then P.candAt = 0 end

    table.sort(out, function(x, y) return x.q < y.q end)
    local cap = CFG.maxTargets or ENT_BUDGET
    for i = #out, cap + 1, -1 do out[i] = nil end
    cache.ents = out
end

local function rebuildMines(myPos)
