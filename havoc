local function collectInv(charM, plrRef)
    local sections = {}
    local plr = plrRef
    local bp = nil
    pcall(function() if plr then bp = plr:FindFirstChildOfClass("Backpack") end end)
    local SLOTS = { backpack="Bag", helmet="Helmet", armor="Armor",
                    lower_armor="Lower Armor", gloves="Gloves", face_cover="Face Cover" }
    if bp then
        local eq = nil
        pcall(function()
            for _, c in ipairs(bp:GetChildren()) do
                if c.Name:lower() == "equipment" then eq = c break end
            end
        end)
        if eq then
            local gear = {}
            pcall(function()
                for _, c in ipairs(eq:GetChildren()) do
                    local lbl = SLOTS[c.Name:lower()] or cap(c.Name:lower())
                    local f = nil
                    pcall(function() f = c.Value end)
                    if f then
                        local nm = ""
                        pcall(function() nm = f.Name end)
                        if nm ~= "" and nm:lower() ~= "unreadable_name" then
                            gear[#gear+1] = { name = lbl..": "..cap(nm), isGear = true }
                        end
                    end
                end
            end)
            if #gear > 0 then sections[#sections+1] = { header = "[Equipment]", items = gear } end
        end
        local carried, seenW = {}, {}
        for _, o in ipairs(charM:GetChildren()) do
            if o.ClassName == "Tool" then seenW[o.Name] = true break end
        end
        pcall(function()
            for _, o in ipairs(bp:GetChildren()) do
                if o.ClassName == "Tool" then
                    local n = o.Name
                    if n:lower() ~= "fists" and not seenW[n] then
                        if isWeaponTool(o) then
                            seenW[n] = true
                            sections[#sections+1] = { header = "[Secondary] "..n, items = weaponData(o) }
                        else carried[#carried+1] = { name = n } end
                    end
                end
            end
        end)
        if #carried > 0 then sections[#sections+1] = { header = "[Carried Items]", items = carried } end
    end
    local eq2, eqName = nil, ""
    for _, o in ipairs(charM:GetChildren()) do
        if o.ClassName == "Tool" then eq2 = o; eqName = o.Name break end
    end
    if eq2 then
        table.insert(sections, 1, { header = "[Primary] "..eqName, items = weaponData(eq2) })
    end
    return sections
end
local function buildInvLines(label, sections)
    local out = {}
    out[#out+1] = { text = label, color = T.accent }
