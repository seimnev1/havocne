local Ease = {}
function Ease.outCubic(t) return 1 - (1 - t) ^ 3 end
function Ease.outQuint(t) return 1 - (1 - t) ^ 5 end
function Ease.inOut(t)
    return t < 0.5 and 4 * t * t * t or 1 - ((-2 * t + 2) ^ 3) / 2
end

local function blend(a, b, t)
    if t <= 0 then return a end
    if t >= 1 then return b end
    return rgb(floor(lerp(a.R * 255, b.R * 255, t)),
               floor(lerp(a.G * 255, b.G * 255, t)),
               floor(lerp(a.B * 255, b.B * 255, t)))
end

local function hsv(h, s, v)
    local i = floor(h * 6)
    local f = h * 6 - i
    local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
    local m = i % 6
    local r, g, b
    if m == 0 then r, g, b = v, t, p
    elseif m == 1 then r, g, b = q, v, p
    elseif m == 2 then r, g, b = p, v, t
    elseif m == 3 then r, g, b = p, q, v
    elseif m == 4 then r, g, b = t, p, v
    else r, g, b = v, p, q end
    return rgb(floor(r * 255), floor(g * 255), floor(b * 255))
end

