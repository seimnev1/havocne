                    local dx, dy, dz = rp.X-myPos.X, rp.Y-myPos.Y, rp.Z-myPos.Z
                    if dx*dx+dy*dy+dz*dz <= dsq then
                        local t = sliderTier(obj.Name)
                        local c = (t and HAZ_COL.sliderC[t]) or HAZ_COL.sliderF
                        out[#out+1] = { part=a,
                            label=(t and ("[SLIDER T"..t.."]") or "[SLIDER]"), color=hazCol(c) }
                    end
                end
            end
        end)
    end

    if CFG.mineEnabled then
        local mf = resolveFolder("mine", function() return Workspace.Buildings.EventObjects.Minefields end)
        local dsq = HAZ_DIST.mine * HAZ_DIST.mine
        if mf and mf.Parent then
            local ok, desc = pcall(function() return mf:GetDescendants() end)
            if ok and desc then
                for _, obj in ipairs(desc) do
                    if obj.Name == "MineHitbox" and obj.Parent then
                        local rp = obj.Position
                        if rp then
                            local dx, dy, dz = rp.X-myPos.X, rp.Y-myPos.Y, rp.Z-myPos.Z
                            if dx*dx+dy*dy+dz*dz <= dsq then
                                out[#out+1] = { part=obj, label="[MINE]",
                                    color=hazCol(HAZ_COL.mine), isMine=true }
                            end
                        end
                    end
                end
            end
        end
    end

    local nowT = tick()
    for _, old in ipairs(hazObjects) do
        local p = old.part
        local alive = p and p.Parent and p.Position
        local pk = partKey(p)
        if not alive and old.lastPos and pk and not S.hazGone[pk] then
            S.hazDied[pk] = S.hazDied[pk] or nowT
            if nowT - S.hazDied[pk] < HAZ_FADE then
                out[#out + 1] = old
            else
                S.hazGone[pk] = true   -- removed part, fade done: never again
            end
        end
    end
    for p, t in pairs(S.hazDied) do
        if nowT - t > HAZ_FADE * 3 then S.hazDied[p] = nil end
    end

    for _, e in ipairs(out) do
        local p = e.part
        local pos = (p and p.Parent and p.Position) or e.lastPos
        if pos then
            local dx, dy, dz = pos.X-myPos.X, pos.Y-myPos.Y, pos.Z-myPos.Z
            e._dsq = dx*dx+dy*dy+dz*dz
        else e._dsq = 1e18 end
    end
    table.sort(out, function(a, b) return a._dsq < b._dsq end)
    hazObjects = out
end

