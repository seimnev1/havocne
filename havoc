    if not bps then return nil end
    local target = nil
    local link = charM:FindFirstChild("backpackFolder") or charM:FindFirstChild("backpack")
    if link and link.Value then target = link.Value end
    if not target then
        local ok, kids = pcall(function() return bps:GetChildren() end)
        if ok and kids then
            for _, bp in ipairs(kids) do
                local ow = bp:FindFirstChild("owner") or bp:FindFirstChild("Owner")
                if ow and ow.Value == charM then target = bp break end
                local nv = bp:FindFirstChild("name") or bp:FindFirstChild("characterName")
                if nv and nv.Value == charM.Name then target = bp break end
            end
        end
    end
    if not target then return nil end
    local itf = target:FindFirstChild("items")
    if not itf then return nil end
    local ok, kids = pcall(function() return itf:GetChildren() end)
    if not ok or not kids then return nil end
    local counts, seen, lines = {}, {}, {}
    for _, it in ipairs(kids) do counts[it.Name] = (counts[it.Name] or 0) + 1 end
    for _, it in ipairs(kids) do
        if not seen[it.Name] then
            seen[it.Name] = true
            local c = counts[it.Name]
