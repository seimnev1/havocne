local function rebuildEntities()
    local ch = LocalPlayer and LocalPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local myPos = hrp.Position
    local maxDSq = CFG.entityMaxDist * CFG.entityMaxDist
    local myId, myName
    pcall(function() myId = LocalPlayer.UserId end)
    pcall(function() myName = LocalPlayer.Name end)
    local function isLocal(plr)
        if plr == LocalPlayer then return true end
        local ok, uid = pcall(function() return plr.UserId end)
        if ok and myId and uid == myId then return true end
        local ok2, nm = pcall(function() return plr.Name end)
        if ok2 and myName and nm == myName then return true end
        return false
    end

    local pChar, pName = {}, {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then pChar[plr.Character] = true end
        pName[plr.Name] = true
    end
    if ch then pChar[ch] = true end
    if myName then pName[myName] = true end
    local active = {}

    if CFG.showPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if not isLocal(plr) then
                local ok, pc = pcall(function() return plr.Character end)
                if ok and pc then
                    local ok2, ph = pcall(function() return pc:FindFirstChild("HumanoidRootPart") end)
                    if ok2 and ph and ph.Parent then
                        local rp = ph.Position
                        local dx, dy, dz = rp.X-myPos.X, rp.Y-myPos.Y, rp.Z-myPos.Z
                        local dsq = dx*dx+dy*dy+dz*dz
                        if dsq <= maxDSq then
                            local id = "plr_" .. plr.UserId
                            active[id] = true
                            local e = _entMap[id]
                            if not e then
                                local ok3, hum = pcall(function() return pc:FindFirstChild("Humanoid") end)
                                _entMap[id] = { hrp=ph, char=pc, label=plr.Name, plr=plr,
                                    hum=ok3 and hum or nil, isPlayer=true, _dsq=dsq }
                            else
                                if e.char ~= pc then
                                    e.rig=nil; e._wname=nil; e._aimBone=nil; e._boxH=nil
                                end
                                e.hrp=ph; e.char=pc; e._dsq=dsq
                                if not e.hum or not e.hum.Parent then
                                    local ok3, hum = pcall(function() return pc:FindFirstChild("Humanoid") end)
                                    if ok3 then e.hum = hum end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if CFG.showNPCs then
        local function tryNPC(child)
            if child.ClassName == "Model" and not pChar[child]
               and not pName[child.Name] and child ~= ch then
                local hum = child:FindFirstChild("Humanoid")
                if hum then
                    local ph = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Torso")
                    if ph and ph.Parent then
                        local rp = ph.Position
                        local dx, dy, dz = rp.X-myPos.X, rp.Y-myPos.Y, rp.Z-myPos.Z
                        local dsq = dx*dx+dy*dy+dz*dz
                        if dsq <= maxDSq then
                            local addr; pcall(function() addr = child.Address end)
                            local id = "npc_" .. tostring(addr or child)
                            active[id] = true
                            local e = _entMap[id]
                            if not e then
                                _entMap[id] = { hrp=ph, char=child, label=child.Name,
                                    hum=hum, isPlayer=false, _dsq=dsq }
                            else
                                if e.char ~= child then
                                    e.rig=nil; e._wname=nil; e._aimBone=nil; e._boxH=nil
                                end
                                e.hrp=ph; e.char=child; e._dsq=dsq
                                if not e.hum or not e.hum.Parent then e.hum = hum end
                            end
                        end
                    end
                end
            end
        end
        local ok, kids = pcall(function() return Workspace:GetChildren() end)
        if ok and kids then
            for _, cont in ipairs(kids) do
                if not pChar[cont] and cont ~= ch then
                    local cn = cont.ClassName
                    if cn == "Folder" or cn == "Model" then
                        local ok2, sub = pcall(function() return cont:GetChildren() end)
                        if ok2 and sub then
                            for _, c2 in ipairs(sub) do tryNPC(c2) end
                        end
                    end
                end
            end
        end
        local ok3, objF = pcall(function() return Workspace.Buildings.Loots.Objects end)
        if ok3 and objF then
            local ok4, sub = pcall(function() return objF:GetChildren() end)
            if ok4 and sub then for _, c2 in ipairs(sub) do tryNPC(c2) end end
        end
    end

    local now = tick()
    for id in pairs(_entMap) do
        if not active[id] then
            if not _entDead[id] then _entDead[id] = now
            elseif now - _entDead[id] > ENT_GRACE then
                _entMap[id] = nil; _entDead[id] = nil
            end
        else _entDead[id] = nil end
    end

    local out = {}
    for _, e in pairs(_entMap) do out[#out + 1] = e end
    table.sort(out, function(a, b) return a._dsq < b._dsq end)
    for i = ENT_MAX + 1, #out do out[i] = nil end
    entObjects = out
end

