function UI:Window(opts)
    opts = opts or {}
    refreshViewport()

    local size = opts.size or V2(640, 520)
    local win = setmetatable({
        id = #windows + 1,
        title = opts.title or "Window",
        subtitle = opts.subtitle,
        size = size,
        pos = opts.pos or V2(floor((VX - size.X) / 2), floor((VY - size.Y) / 2)),
        minSize = opts.minSize or V2(420, 300),
        open = true,
        tab = 1,
        tabs = {},
        z = 200 + #windows * 100,
        animOpen = 0,
        key = opts.key or 0x24,
        drag = {},
        dropdown = {},
        picker = {},
        browser = {},
        list = {},
    }, Window)

    if opts.theme then UI:SetTheme(opts.theme) end
    if opts.accent then UI:SetAccent(opts.accent) end
    if opts.font then UI:SetFont(opts.font) end

    windows[#windows + 1] = win
    return win
end

function UI:SetTheme(name)
    local t = Themes[name]
    if not t then return false end
    State.themeName, State.theme = name, t

    if t.light then Glass.enabled = true end

    UI._forceDraw = true
    return true
end

function UI:SetAccent(value)
    if typeof and typeof(value) == "Color3" then
        State.accent = value
        return true
    end
    local a = Accents[value]
    if not a then return false end
    State.accentName, State.accent = value, a
    return true
end

function UI:SetFont(name)
    if not Fonts[name] then return false end
    State.fontName = name
    for _, o in ipairs(pool.text) do
        setProp(o, "Font", Fonts[name])
    end
    UI._forceDraw = true
    return true
end

function UI:GetFont() return State.fontName end

function UI:ListFonts()
    local out = {}
    for i, name in ipairs(FontNames) do out[i] = name end
    return out
end

function UI:SetGlass(state)
    local want = (state == nil) and not Glass.enabled or state
    if want == Glass.enabled then return Glass.enabled end

    Glass.enabled = want
    if want then
        Glass.savedOpacity = State.opacity
        State.opacity = 0
    else
        State.opacity = Glass.savedOpacity or 0.97
    end

    UI._forceDraw = true
    return Glass.enabled
end

function UI:GetGlass() return Glass.enabled end

--- Refresh every flagged widget from a table of values.
---
--- Callbacks are deliberately not fired: the source table is already the
--- authority, and re-firing would write the value straight back.
function UI:Sync(values)
    if type(values) ~= "table" then return end
    for _, win in ipairs(windows) do
        for _, tab in ipairs(win.tabs) do
            for _, sec in ipairs(tab.sections) do
                for _, w in ipairs(sec.widgets) do
                    if w.flag ~= nil then
                        local v = values[w.flag]
                        if v ~= nil then w.value = v end
                    end
                end
            end
        end
    end
    UI._forceDraw = true
end

function UI:SetOpacity(v)
    State.opacity = clamp(v, 0, 1)
    UI._forceDraw = true
end

function UI:GetOpacity() return State.opacity end
function UI:GetTheme() return State.themeName end
function UI:GetAccent() return State.accentName end
function UI:ListThemes()
    local out = {}
    for k in pairs(Themes) do out[#out + 1] = k end
    table.sort(out)
    return out
end
function UI:ListAccents()
    local out = {}
    for k in pairs(Accents) do out[#out + 1] = k end
    table.sort(out)
    return out
end

local function renderFrame()
    refreshViewport()
    local mx, my = cursor()

    local moved = (mx ~= lastCursor.x) or (my ~= lastCursor.y)
    local typing = false
    for _, win in ipairs(windows) do
        for _, tab in ipairs(win.tabs) do
            for _, s in ipairs(tab.sections) do
                for _, w in ipairs(s.widgets) do
                    if (w.kind == "search" and w.focused)
                       or (w.kind == "keybind" and w.listening) then
                        typing = true
                    end
                end
            end
        end
    end

    local sweeping = Glass.enabled
        and (tick() - Glass.sweepAt) < Glass.sweepTime

    -- The signature is rebuilt every frame, and it usually carries a clock, so
    -- skipping it while hidden avoids forcing a redraw once a second for
    -- something nobody can see.
    local wmChanged = false
    if watermark and watermark.get and watermark.visible ~= false then
        local ok, parts = pcall(watermark.get)
        if ok and type(parts) == "table" then
            local sig = table.concat(parts, "|")
            if sig ~= watermark.sig then watermark.sig = sig; wmChanged = true end
        end
    end

    local mustDraw = moved or Anim.busy or typing or #Toasts > 0
                     or lastDown or UI._forceDraw or hudChanged() or sweeping
                     or wmChanged
    if not mustDraw then return end

    UI._forceDraw = false
    lastCursor.x, lastCursor.y = mx, my

    Anim.busy = false
    tickGlass()
    hits = {}
    beginFrame()

    pcall(drawHuds, mx, my)
    pcall(drawWatermark, mx, my)

    for _, win in ipairs(windows) do
        local okw, errw = pcall(drawWindow, win, mx, my)
        if not okw then UI._lastError = tostring(errw) end
    end
    pcall(drawToasts)

    local anyOpen = false
    for _, win in ipairs(windows) do if win.open then anyOpen = true end end
    if anyOpen then
        rect(mx - 5, my, 11, 1, State.black, 9500, 1)
        rect(mx, my - 5, 1, 11, State.black, 9500, 1)
        rect(mx - 4, my, 9, 1, State.white, 9501, 1)
        rect(mx, my - 4, 1, 9, State.white, 9501, 1)
    end

    endFrame()
end


local function inputFrame()
    local mx, my = cursor()
    local down = mouse1()

    for _, win in ipairs(windows) do

        if win.drag.widget then
            if down then
                local d = win.drag
                d.widget:Set(d.widget.min + (d.widget.max - d.widget.min)
                    * clamp((mx - d.x) / d.w, 0, 1))
                UI._forceDraw = true
            else
                win.drag.widget = nil
            end
        end

        if win.pickerDrag then
            if down then
                local d = win.pickerDrag
                d.widget[d.key] = clamp((mx - d.x) / d.w, 0, 1)
                d.widget.value = hsv(d.widget.h, d.widget.s, d.widget.v)
                if d.widget.callback then
                    pcall(d.widget.callback, d.widget.value)
                end
                UI._forceDraw = true
            else
                win.pickerDrag = nil
            end
        end

        if win.pageBar then
            if down then
                local b2 = win.pageBar
                local t = clamp((my - b2.y - b2.t / 2) / max(1, b2.h - b2.t), 0, 1)
                win.scroll[b2.tab] = floor(t * b2.over + 0.5)
                UI._forceDraw = true
            else
                win.pageBar = nil
            end
        end

        if win.pageDrag then
            if down then
                local d = win.pageDrag
                win.scroll[d.tab] = clamp(d.s0 + (d.y0 - my), 0, d.over)
                UI._forceDraw = true
            else
                win.pageDrag = nil
            end
        end

        local ls = win.list
        if ls.widget and ls.bar then
            if down then
                local b = ls.bar
                local t = clamp((my - b.y - b.t / 2) / max(1, b.h - b.t), 0, 1)
                ls.widget.scroll = floor(t * b.over + 0.5)
                UI._forceDraw = true
            else
                ls.widget = nil
                ls.bar = nil
            end
        elseif ls.widget then
            if down then
                local dy = my - ls.y0
                if abs(dy) > 4 then ls.moved = true end
                local steps = floor(dy / ls.rowH)
                ls.widget.scroll = clamp(ls.s0 + steps, 0, ls.over)
                UI._forceDraw = true
            else
                if ls.pending and not ls.moved and ls.widget.callback then
                    pcall(ls.widget.callback, ls.pending.entry, ls.pending.index)
                    UI._forceDraw = true
                end
                ls.widget = nil
                ls.pending = nil
                ls.moved = false
            end
        end

        if win.browserDrag then
            if down then
                local d = win.browserDrag
                local dy = my - d.y0
                if abs(dy) > 4 then d.moved = true end
                local steps = floor(dy / d.rowH)
                d.widget.scroll = clamp(d.s0 - steps, 0, d.over)
                UI._forceDraw = true
            else
                local pend = win.browserPend
                if pend and not win.browserDrag.moved then
                    if pend.isDir then
                        pend.widget.cwd = pend.path
                        pend.widget.scroll = 0
                    elseif pend.ok then
                        pend.widget.value = pend.path
                        win.browser.widget = nil
                        if pend.widget.callback then
                            pcall(pend.widget.callback, pend.path)
                        end
                    else
                        local why = READABLE[extOf(pend.path)]
                            and "is not an image file"
                            or "needs a .dat name to be readable"
                        UI:Notify { title = "Cannot use",
                                    text = baseName(pend.path) .. " " .. why,
                                    kind = "warn" }
                    end
                    UI._forceDraw = true
                end
                win.browserPend = nil
                win.browserDrag = nil
            end
        end

        if win.dragWin then
            if down then
                win.pos = V2(clamp(mx - win.dragWin.dx, -win.size.X + 80, VX - 80),
                             clamp(my - win.dragWin.dy, 0, VY - 40))
                UI._forceDraw = true
            else
                win.dragWin = nil
            end
        end

        if win.resizing then
            if down then
                win.size = V2(clamp(mx - win.resizing.dx, win.minSize.X, VX - 20),
                              clamp(my - win.resizing.dy, win.minSize.Y, VY - 20))
                UI._forceDraw = true
            else
                win.resizing = nil
            end
        end

        for _, tab in ipairs(win.tabs) do
            for _, s in ipairs(tab.sections) do
                for _, w in ipairs(s.widgets) do
                    if w.kind == "search" and w.focused then
                        if Keyboard:capture(w) then
                            UI._forceDraw = true
                            if w.callback then pcall(w.callback, w.value) end
                        end
                    end
                end
            end
        end

        if win.key then
            local k = keyDown(win.key)
            if k and not win.keyWas then
                win.open = not win.open
                UI._forceDraw = true
            end
            win.keyWas = k
        end
    end

    if watermark and watermark.drag then
        if down then
            watermark.pos = V2(clamp(mx - watermark.drag.dx, 0, VX - 40),
                               clamp(my - watermark.drag.dy, 0, VY - 24))
            UI._forceDraw = true
        else
            watermark.drag = nil
        end
    end

    for _, h in ipairs(huds) do
        if h.dragging then
            if down then
                h.pos = V2(clamp(mx - h.dragging.dx, 0, VX - 60),
                           clamp(my - h.dragging.dy, 0, VY - 30))
                UI._forceDraw = true
            else
                h.dragging = nil
            end
        end
    end

    for i = 1, #UI._binds do
        local w = UI._binds[i]
        if w.value and not w.listening then
            local held = keyDown(w.value)
            if held and not w.heldWas and w.onPress then
                pcall(w.onPress)
                UI._forceDraw = true
            end
            w.heldWas = held
        else
            w.heldWas = false
        end
    end

    if down and not lastDown then
        for i = #hits, 1, -1 do
            local hRegion = hits[i]
            if inside(mx, my, hRegion[1], hRegion[2], hRegion[3], hRegion[4]) then
                hRegion[5]()
                UI._forceDraw = true
                break
            end
        end
    end
    lastDown = down
end

if RunService then
    connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
        DT = dt or DT
        if destroyed then return end

        local ok, err = pcall(renderFrame)
        if not ok then
            -- The sweep hides whatever went unclaimed. Without it a failed
            -- frame leaves the previous frame's objects on screen forever.
            pcall(endFrame)
            UI._lastError = tostring(err)
            if tick() - (UI._errAt or 0) > 3 then
                UI._errAt = tick()
                warn("[UI] render: " .. UI._lastError)
            end
        end

        local ok2, err2 = pcall(inputFrame)
        if not ok2 then
            UI._lastError = tostring(err2)
            if tick() - (UI._errAt or 0) > 3 then
                UI._errAt = tick()
                warn("[UI] input: " .. UI._lastError)
            end
        end
    end)
end

function UI:Destroy()
    destroyed = true
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    connections = {}

    for _, o in ipairs(tracked) do pcall(function() o.Visible = false end) end
    for _, o in ipairs(tracked) do pcall(function() o:Remove() end) end

    tracked = {}
    pool.rect, pool.text, pool.line, pool.tri = {}, {}, {}, {}
    windows, Toasts, hits, huds = {}, {}, {}, {}
    UI._binds = {}
    imageObjects, imageCache = {}, {}
    Anim.values = {}
end

function UI:Stats()
    return {
        rects = #pool.rect,
        texts = #pool.text,
        lines = #pool.line,
        total = #tracked,
        windows = #windows,
        lastError = UI._lastError,
    }
end

