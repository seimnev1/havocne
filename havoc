local SFX_STRENGTH = {
    BlurEffect            = { 184, 0 },
    BloomEffect           = { 184, 0 },
    SunRaysEffect         = { 184, 0 },
    DepthOfFieldEffect    = { 184, 0 },
    ColorCorrectionEffect = { 196, 0 },
}

local function sfxSweep(fn)
    local roots = { Lighting, Workspace.CurrentCamera }
    for _, r in ipairs(roots) do
        if r then
            local ok, kids = pcall(function() return r:GetChildren() end)
            for _, d in ipairs(kids or {}) do
                local sp = SFX_STRENGTH[d.ClassName]
                if sp then
                    local a
                    pcall(function() a = d.Address end)
                    if a and a ~= 0 then fn(d, a, sp) end
                end
            end
        end
    end
end

local function applyFx()
    if not P.fx.captured then captureFx() end
    if not memory_write then return end

    if P.fx.grassAddr ~= 0 then
        pcall(memory_write, "byte", P.fx.grassAddr + OFF.DECO,
              CFG.noGrass and 0 or 1)
    end

    if CFG.noFog then
        if P.fx.lightAddr ~= 0 then
            pcall(memory_write, "float", P.fx.lightAddr + OFF.FOG_END, 9e8)
            pcall(memory_write, "float", P.fx.lightAddr + OFF.FOG_START, 9e8)
        end
        if P.fx.atmoAddr ~= 0 then
            pcall(memory_write, "float", P.fx.atmoAddr + OFF.ATMO_DENSITY, 0)
            pcall(memory_write, "float", P.fx.atmoAddr + OFF.ATMO_GLARE, 0)
            pcall(memory_write, "float", P.fx.atmoAddr + OFF.ATMO_HAZE, 0)
            pcall(memory_write, "float", P.fx.atmoAddr + OFF.ATMO_OFFSET, 0)
        end
    elseif P.fx.fogWas then
        local fg = P.fx.fog
        local function wr(a, v)
            if type(v) == "number" then pcall(memory_write, "float", a, v) end
        end
        if P.fx.lightAddr ~= 0 then
            wr(P.fx.lightAddr + OFF.FOG_END, fg.e)
            wr(P.fx.lightAddr + OFF.FOG_START, fg.s)
        end
        if P.fx.atmoAddr ~= 0 then
            wr(P.fx.atmoAddr + OFF.ATMO_DENSITY, fg.d)
            wr(P.fx.atmoAddr + OFF.ATMO_GLARE, fg.g)
            wr(P.fx.atmoAddr + OFF.ATMO_HAZE, fg.h)
            wr(P.fx.atmoAddr + OFF.ATMO_OFFSET, fg.o)
        end
    end
    P.fx.fogWas = CFG.noFog

    if CFG.noEffects then
        sfxSweep(function(d, a, sp)
            if P.fx.sfx[a] == nil then
                local e = memory_read and memory_read("byte", a + 176)
                P.fx.sfx[a] = (type(e) == "number") and e or 1
            end
            pcall(memory_write, "byte", a + 176, 0)
            pcall(memory_write, "float", a + sp[1], sp[2])
            if d.ClassName == "ColorCorrectionEffect" then
                pcall(memory_write, "float", a + 200, 0)
            end
        end)
    elseif next(P.fx.sfx) then
        for a, v in pairs(P.fx.sfx) do
            pcall(memory_write, "byte", a + 176, v)
        end
        P.fx.sfx = {}
    end
end

